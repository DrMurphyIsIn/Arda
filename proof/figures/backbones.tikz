% Finished TikZ for the path-vs-star backbone figure (t=3). Requires:
%   \usepackage{tikz}\usetikzlibrary{calc}
\begin{tikzpicture}[scale=0.62,
  ctr/.style={circle,fill=orange!85,draw,minimum size=5.5mm,inner sep=0},
  mid/.style={circle,fill=blue!45,draw,minimum size=2.6mm,inner sep=0},
  lf/.style={circle,fill=blue!20,draw,minimum size=1.8mm,inner sep=0},
  bb/.style={red!75!black,line width=1.6pt},
  ed/.style={gray!55,line width=0.6pt}]
\begin{scope}
  \foreach \i in {0,1,2,3}{\node[ctr](c\i) at (2*\i,0){};}
  \draw[bb] (c0)--(c1)--(c2)--(c3);
  \foreach \i in {0,1,2,3}{\foreach \dx in {-0.55,0,0.55}{
    \draw[ed] (c\i)--($(c\i)+(\dx,-1.1)$)--($(c\i)+(\dx,-2.1)$);
    \node[mid] at ($(c\i)+(\dx,-1.1)$){};
    \node[lf]  at ($(c\i)+(\dx,-2.1)$){};}}
  \node at (3,-3.0){\small $T(t,t,t,t)$: backbone $P_4$ (path)};
\end{scope}
\begin{scope}[xshift=11cm,yshift=-0.4cm]
  \node[ctr](h) at (0,0){};
  \foreach \nm/\ang in {a/90,b/210,d/330}{\node[ctr](\nm) at (\ang:2.4){};\draw[bb](h)--(\nm);}
  \foreach \dx in {-0.55,0,0.55}{
    \draw[ed] (h)--($(h)+(\dx,-1.05)$)--($(h)+(\dx,-1.95)$);
    \node[mid] at ($(h)+(\dx,-1.05)$){};
    \node[lf]  at ($(h)+(\dx,-1.95)$){};}
  \foreach \nm/\ang in {a/90,b/210,d/330}{\foreach \k in {-1,0,1}{
    \draw[ed] (\nm)--($(\nm)+({\ang+20*\k}:1.0)$)--($(\nm)+({\ang+20*\k}:1.9)$);
    \node[mid] at ($(\nm)+({\ang+20*\k}:1.0)$){};
    \node[lf]  at ($(\nm)+({\ang+20*\k}:1.9)$){};}}
  \node at (0,-3.1){\small $B(3,t)$: backbone $K_{1,3}$ (star)};
\end{scope}
\end{tikzpicture}
