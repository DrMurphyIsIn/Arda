% Fig: shape-quantized cavity spectrum (E1-E4 + Cantor chain gaps).  x = cavity mu.
\resizebox{\textwidth}{!}{%
\begin{tikzpicture}[x=26cm,y=1cm,
  nstick/.style={blue!60!black,line width=1pt},
  gap/.style={red!14},
  lab/.style={font=\small},
  brc/.style={decorate,decoration={brace,amplitude=5pt,mirror},line width=0.7pt},
  reg/.style={font=\small,align=center}]
% ===== forbidden band + Cantor gaps (drawn first, behind) =====
\fill[gap] (0.3333,-0.05) rectangle (0.4,1.05);                 % E1 forbidden band
\fill[gap] (0.4167,-0.05) rectangle (0.4286,0.72);             % chain gap (5/12,3/7)
\fill[gap] (0.4118,-0.05) rectangle (0.4138,0.52);             % 2nd-order
\fill[gap] (0.4108,-0.05) rectangle (0.4118,0.40);           % 3rd-order
% ===== axis =====
\draw[->,line width=0.8pt] (0,0) -- (0.53,0) node[right,lab]{$\mu$};
\foreach \x/\t in {0/0, 0.25/{\tfrac14}, 0.3333/{\tfrac13}, 0.4/{\tfrac25}, 0.5/{\tfrac12}}
  {\draw (\x,0.07)--(\x,-0.07); \node[below,lab] at (\x,-0.11){$\t$};}
% ===== near-star ticks (above), accumulating toward 0 =====
\foreach \x in {0.4286,0.2727,0.2,0.1579,0.1304,0.1111,0.0968,0.0857,0.0769,0.0698,0.0638,0.0588,0.0545,0.0508,0.0476}
  {\draw[nstick] (\x,0)--(\x,0.14);}
\fill[orange!85!black] (0.1304,0) circle (2pt);
\node[orange!70!black,lab,anchor=west] at (0.145,0.30){tie $=\tfrac{3}{23}$};
\draw[orange!60!black,line width=0.4pt] (0.144,0.28)--(0.1304,0.03);
\node[blue!55!black,lab] at (0.11,0.62){near-star cavities $\tfrac{3}{4s'+3}\!\downarrow\!0$};
% ARM at exactly 1/3 (left edge of the forbidden band)
\fill[orange!85!black] (0.3333,0) circle (2pt);
\node[orange!65!black,lab,anchor=east] at (0.328,0.24){$\mathrm{ARM}=\tfrac13$};
\draw[orange!60!black,line width=0.4pt] (0.328,0.22)--(0.3333,0.02);
% mu* dashed vertical (E3/E4 boundary)
\draw[orange!85!black,line width=1pt,dashed] (0.2732,-0.05)--(0.2732,0.78);
\node[orange!70!black,lab,above] at (0.2732,0.78){$\mu_*\!=\!0.2732$};
% sqrt2-1 accumulation
\draw[red!60,line width=0.9pt,dashed] (0.4142,-0.05)--(0.4142,0.90);
\node[red!55!black,lab,above] at (0.4142,0.90){$\sqrt2-1$};
% E1 forbidden label (above, red)
\node[reg,text=red!60!black] at (0.3667,0.62){E1: \emph{forbidden}\\ (no branch)};
% ===== region braces below =====
\draw[brc] (0.006,-0.32) -- (0.2732,-0.32)
  node[midway,below=5pt,reg]{E4: $\ell\le\omega$ \ (gap-IH)};
\draw[brc] (0.2732,-0.78) -- (0.3333,-0.78)
  node[midway,below=4pt,reg,font=\footnotesize]{E3: shapes\\ $(2,0),(1,1)$};
\draw[brc] (0.4,-0.32) -- (0.5,-0.32)
  node[midway,below=5pt,reg]{E2: chains only\\ (Cantor gaps)};
\end{tikzpicture}}
