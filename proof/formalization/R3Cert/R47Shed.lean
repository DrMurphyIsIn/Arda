/-- L1 c0-shedding, c0=0, endpoint 0 (K = 25 + t) -/
theorem shed_L1_c0_s0 (t : ℝ) (ht : 0 ≤ t) :
    ((1 + (3 * (1 / (79 + (3 * t))) * ((11033 / 3933) + ((1 / 9) * t)))) * ((1539 / 160) + ((513 / 80) * (1 / (52 + (2 * t))))))
      ≤ ((621 / 64) + ((1863 / 64) * (1 / (75 + (3 * t))) * ((25 / 9) + ((1 / 9) * t)))) := by
  rw [← sub_nonneg]
  have hd0 : (t + 26 : ℝ) ≠ 0 := by positivity
  have hkey : ((621 / 64) + ((1863 / 64) * (1 / (75 + (3 * t))) * ((25 / 9) + ((1 / 9) * t))))
      - ((1 + (3 * (1 / (79 + (3 * t))) * ((11033 / 3933) + ((1 / 9) * t)))) * ((1539 / 160) + ((513 / 80) * (1 / (52 + (2 * t))))))
      = (345 * t + 132)
        / (3680 * (t + 26)) := by
    field_simp
    ring
  rw [hkey]
  positivity

