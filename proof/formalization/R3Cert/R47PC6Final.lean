  · obtain ⟨hZ, hO, hu, hAob⟩ := pair_stats_count armsA 5 armsB 4 hbA hbB
    rw [hZ]; exact pc6r_d9p_c5_W1 a5 a4 b5 b4 hA5 hB5
  · obtain ⟨hZ, hO, hu, hAob⟩ := pair_stats_count armsA 5 armsB 4 hbA hbB
