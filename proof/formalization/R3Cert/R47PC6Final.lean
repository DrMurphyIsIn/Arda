  set a5 := armsA.count 5 with ha5
  set a4 := armsA.count 4 with ha4
  set b5 := armsB.count 5 with hb5
  set b4 := armsB.count 4 with hb4
  refine ⟨hubArms (a5 + b5) (a4 + b4 + 1), 5, balancedArms_hubArms _ _, by omega,
