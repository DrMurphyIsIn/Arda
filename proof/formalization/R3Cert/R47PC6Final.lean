    ∃ (arms' : List ℕ) (c' : ℕ),
      BalancedArms arms' ∧ c' ≤ 5 ∧ 5 ≤ arms'.length
      ∧ hubSize (arms', c') = hubSize (armsA, 5) + hubSize (armsB, 4)
      ∧ Ztot (dtSub (backboneU [(armsA, 5), (armsB, 4)]))
          ≤ Ztot (dtSub (backboneU [(arms', c')]))
      ∧ Ztot (dtSub (backboneU [(armsA, 5), (armsB, 4)]))
            + Zopen (dtSub (backboneU [(armsA, 5), (armsB, 4)]))
              / (6 * (udeg (backboneU [(armsA, 5), (armsB, 4)]) : ℝ))
          ≤ Ztot (dtSub (backboneU [(arms', c')]))
            + Zopen (dtSub (backboneU [(arms', c')]))
              / (6 * (udeg (backboneU [(arms', c')]) : ℝ))
      ∧ Aobj (backboneU [(armsA, 5), (armsB, 4)])
