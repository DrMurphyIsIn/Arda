-- Two-point spreading exchange (the vertex-lemma engine), exact identity.
-- (1+mi/3)(1+mj/3) - (1+(mi-t)/3)(1+(mj+t)/3) = t*(mj-mi+t)/9 >= 0 for t>=0, mi<=mj.
theorem exchange_identity (mi mj t : ℝ) :
    (1 + mi/3)*(1 + mj/3) - (1 + (mi - t)/3)*(1 + (mj + t)/3)
      = t*(mj - mi + t)/9 := by ring
theorem exchange_nonneg (mi mj t : ℝ) (ht : 0 ≤ t) (hij : mi ≤ mj) :
    (1 + (mi - t)/3)*(1 + (mj + t)/3) ≤ (1 + mi/3)*(1 + mj/3) := by
  have h : (1 + mi/3)*(1 + mj/3) - (1 + (mi - t)/3)*(1 + (mj + t)/3)
      = t*(mj - mi + t)/9 := by ring
  nlinarith [h, ht, hij, mul_nonneg ht (by linarith : (0:ℝ) ≤ mj - mi + t)]

-- glemma(1/2) < 1 (the b-tail geometric ratio), integer cert.
theorem glemma_half_lt_one : (64:ℕ)^2 * 5^11 * 2^11 < 621^2 * 7^11 := by norm_num

-- Bcap(1) = W anchor: glemma(1) = W^2 (5/4)^11 >= W  <=>  W (5/4)^11 >= 1
--   <=> 64*5^11 >= 621*4^11.
theorem glemma_one_ge_W : (621:ℕ) * 4^11 ≤ 64 * 5^11 := by norm_num

