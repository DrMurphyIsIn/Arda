theorem box0 : BandGlue.BoxCert (1 / 4000000) (3999999 / 4000000) (AllZeros_h7000.bLo 0) (AllZeros_h7000.bHi 0) := by
  have hc := chk0
  rw [Bool.and_eq_true] at hc
  have hT0 : (Arb4.BandGlue_h7000.seg 0).T0 = (Q.ofNat 6000).val := (Q.cv_nat 6000).symm
