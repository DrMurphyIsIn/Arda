  · show EdgeClearGlue.SlabClear (6038 : ℝ) ((6038 : ℝ) + 60759 / 1000000)
    exact Arb4.H7000.S_U6038_clear
  · show DiffractionCore.argChangeHoriz riemannZeta (6038 : ℝ) 2 (-1) ∈ Set.Icc (Arb4.H7000.E_T6038.Lo).val (Arb4.H7000.E_T6038.Hi).val
