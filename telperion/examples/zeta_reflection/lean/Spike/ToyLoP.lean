@[inline] def evalPLoP (mp : Int × Int) : Option Bool :=
  let x : DIntv := DIntv.ofDyadic mp.1 mp.2
  let x2 : DIntv := DIntv.mul x x
  let two : DIntv := DIntv.ofDyadic 2 0
  (DIntv.sub x2 two).sign?
def checkAltLoP : List (Int × Int) -> Bool
  | [] => true
  | [p] => (evalPLoP p).isSome
  | p :: q :: rest =>
    match evalPLoP p, evalPLoP q with
    | some sp, some sq => (sp != sq) && checkAltLoP (q :: rest)
    | _, _ => false
theorem toy_ok_lop : checkAltLoP ptsLoP = true := rfl
end Spike
