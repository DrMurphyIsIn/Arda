  (Q.frac 129840821139 1000000000), (Q.frac 129840963623 1000000000), (Q.frac 5193632823 40000000), (Q.frac 6492048153 50000000)⟩

theorem chk0 : (validB (Q.ofNat 7000) (Q.ofNat 7037) (Q.frac 14037 2) (Q.frac 5513 16) 41 E0 && k6sideB G_T7000 G_T7037 E0) = true := by decide +kernel

theorem box0 : BandGlue.BoxCert (1 / 4000000) (3999999 / 4000000) (AllZeros_h8000.bLo 0) (AllZeros_h8000.bHi 0) := by
  have hc := chk0
  rw [Bool.and_eq_true] at hc
  have hT0 : (Arb4.BandGlue_h8000.seg 0).T0 = (Q.ofNat 7000).val := (Q.cv_nat 7000).symm
  have hT1 : (Arb4.BandGlue_h8000.seg 0).T1 = (Q.ofNat 7037).val := (Q.cv_nat 7037).symm
  have hcc : (Arb4.BandGlue_h8000.seg 0).c = (⟨1 / 2, (Q.frac 14037 2).val⟩ : ℂ) := by rw [(Q.cv_frac 14037 2)]; rfl
  have hR : (Arb4.BandGlue_h8000.seg 0).R = Real.sqrt (Q.frac 5513 16).val := by rw [(Q.cv_frac 5513 16)]; rfl
  refine boxCert_of_parts (Arb4.BandGlue_h8000.seg 0) E0 (Arb4.BandGlue_h8000.seg_edge 0 (by norm_num)).1
    (Arb4.BandGlue_h8000.seg_edge 0 (by norm_num)).2 (valid_of_B _ _ _ _ _ E0 hT0 hT1 hcc hR hc.1)
    (Arb4.BandGlue_h8000.seg_geom 0 (by norm_num)) ?_ ?_ ?_ (k6side_of_B _ G_T7000 G_T7037 E0 hT0 hT1 hc.2) ?_ ?_
  · exact Arb4.H8000.B00_line
  · show EdgeClearGlue.SlabClear ((7000 : ℝ) - 12479 / 200000) (7000 : ℝ)
    exact Arb4.H8000.S_L7000_clear
  · show EdgeClearGlue.SlabClear (7037 : ℝ) ((7037 : ℝ) + 12479 / 200000)
    exact Arb4.H8000.S_U7037_clear
  · show DiffractionCore.argChangeHoriz riemannZeta (7037 : ℝ) 2 (-1) ∈ Set.Icc (Arb4.H8000.E_T7037.Lo).val (Arb4.H8000.E_T7037.Hi).val
