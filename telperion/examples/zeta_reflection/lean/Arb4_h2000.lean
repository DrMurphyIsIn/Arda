/-! ### Band 0: `[1000, 1040]`, 32 zeros -/

/-- The five enclosures of band 0: K6a, the edges at 1040 and 1000, K6b. -/
noncomputable def E0 : EnclQ := ⟨Q.frac (-249) 250, Q.frac 249 250, Arb4.H2000.E_T1040.Lo, Arb4.H2000.E_T1040.Hi, Arb4.H1000.E_T1000.Lo, Arb4.H1000.E_T1000.Hi,
  (Q.frac 3180996349 31250000), (Q.frac 101792863937 1000000000), (Q.frac 101791854323 1000000000), (Q.frac 10179283509 100000000)⟩

theorem chk0 : (validB (Q.ofNat 1000) (Q.ofNat 1040) (Q.ofNat 1020) (Q.frac 6437 16) 32 E0 && k6sideB G_T1000 G_T1040 E0) = true := by decide +kernel

theorem box0 : BandGlue.BoxCert (1 / 4000000) (3999999 / 4000000) (AllZeros_h2000.bLo 0) (AllZeros_h2000.bHi 0) := by
  have hc := chk0
  rw [Bool.and_eq_true] at hc
  have hT0 : (Arb4.BandGlue_h2000.seg 0).T0 = (Q.ofNat 1000).val := (Q.cv_nat 1000).symm
  have hT1 : (Arb4.BandGlue_h2000.seg 0).T1 = (Q.ofNat 1040).val := (Q.cv_nat 1040).symm
  have hcc : (Arb4.BandGlue_h2000.seg 0).c = (⟨1 / 2, (Q.ofNat 1020).val⟩ : ℂ) := by rw [(Q.cv_nat 1020)]; rfl
  have hR : (Arb4.BandGlue_h2000.seg 0).R = Real.sqrt (Q.frac 6437 16).val := by rw [(Q.cv_frac 6437 16)]; rfl
  refine boxCert_of_parts (Arb4.BandGlue_h2000.seg 0) E0 (Arb4.BandGlue_h2000.seg_edge 0 (by norm_num)).1
    (Arb4.BandGlue_h2000.seg_edge 0 (by norm_num)).2 (valid_of_B _ _ _ _ _ E0 hT0 hT1 hcc hR hc.1)
    (Arb4.BandGlue_h2000.seg_geom 0 (by norm_num)) ?_ ?_ ?_ (k6side_of_B _ G_T1000 G_T1040 E0 hT0 hT1 hc.2) ?_ ?_
  · exact Arb4.H2000.B00_line
  · show EdgeClearGlue.SlabClear ((1000 : ℝ) - 5773 / 100000) (1000 : ℝ)
    exact Arb4.H2000.S_L1000_clear
  · show EdgeClearGlue.SlabClear (1040 : ℝ) ((1040 : ℝ) + 5773 / 100000)
    exact Arb4.H2000.S_U1040_clear
  · show DiffractionCore.argChangeHoriz riemannZeta (1040 : ℝ) 2 (-1) ∈ Set.Icc (Arb4.H2000.E_T1040.Lo).val (Arb4.H2000.E_T1040.Hi).val
    exact Arb4.H2000.E_T1040_hAH
  · show DiffractionCore.argChangeHoriz riemannZeta (1000 : ℝ) 2 (-1) ∈ Set.Icc (Arb4.H1000.E_T1000.Lo).val (Arb4.H1000.E_T1000.Hi).val
    exact Arb4.H1000.E_T1000_hAH

