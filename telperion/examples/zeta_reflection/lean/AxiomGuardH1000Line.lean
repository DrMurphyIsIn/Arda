/-- `hLine` of every band of the height-1000 segment, hypothesis-free. -/
example : ∀ i, i < 25 → (BandGlue_h1000.seg i).LineHyp := H1000Line.seg_lineHyp

/-- The ladder statement from the off-line inputs only (hLine and hγ discharged). -/
example
    (hslab0 : ∀ i, i < 25 → EdgeClearGlue.SlabClear ((BandGlue_h1000.seg i).T0 - BandGlue_h1000.capLo i)
      (BandGlue_h1000.seg i).T0)
    (hslab1 : ∀ i, i < 25 → EdgeClearGlue.SlabClear (BandGlue_h1000.seg i).T1
      ((BandGlue_h1000.seg i).T1 + BandGlue_h1000.capHi i))
    (henc : ∀ i, i < 25 → (BandGlue_h1000.seg i).EnclHyp) :
    ∀ ρ : ℂ, riemannZeta ρ = 0 → 0 < ρ.im → ρ.im ≤ 1000 → ρ.re = 1 / 2 :=
  H1000Line.all_nontrivial_zeros_up_to_height_1000_of_offline hslab0 hslab1 henc

/-- The integration target: enclosure data, pins, enclosures and 49 slabs only. -/
example (E : ℕ → H1000Line.Encl) (hpin : ∀ i, i < 25 → H1000Line.PinOk i (E i))
    (henc : ∀ i, i < 25 → (H1000Line.segWith i (E i)).EnclHyp)
    (hslab0 : ∀ i, 1 ≤ i → i < 25 → EdgeClearGlue.SlabClear
      ((BandGlue_h1000.seg i).T0 - BandGlue_h1000.capLo i) (BandGlue_h1000.seg i).T0)
    (hslab1 : ∀ i, i < 25 → EdgeClearGlue.SlabClear (BandGlue_h1000.seg i).T1
      ((BandGlue_h1000.seg i).T1 + BandGlue_h1000.capHi i)) :
    ∀ ρ : ℂ, riemannZeta ρ = 0 → 0 < ρ.im → ρ.im ≤ 1000 → ρ.re = 1 / 2 :=
  H1000Line.all_nontrivial_zeros_up_to_height_1000_of_encl E hpin henc hslab0 hslab1

