/-- Each box of `AllZeros_h1000` has a band certificate once its band's Arb inputs hold (the
    certificate interface of `BandGlue.BoxCert`, filled by the real `rh_in_box_*` theorems). -/
theorem boxCert_of_inputs (i : ℕ) (hi : i < 25) (hin : (seg i).Inputs) :
    BoxCert (1 / 4000000) (3999999 / 4000000) (AllZeros_h1000.bLo i) (AllZeros_h1000.bHi i) :=
  BoxCert.of_stmt (seg i) (seg_edge i hi).1 (seg_edge i hi).2 (seg_stmt i hi) hin

/-- **K0 on `AllZeros_h1000`**: the segment's band hypothesis from the per-band Arb inputs
    (`hLine`, `hArbT` of each band theorem), composed through the real `rh_in_box_*` theorems. -/
theorem bandHyp_of_inputs (hin : ∀ i, i < 25 → (seg i).Inputs) : AllZeros_h1000.BandHyp :=
  segBandHyp_of_bands seg seg_edge seg_stmt hin

/-- **K0 + K1 on `AllZeros_h1000`**: the segment's band hypothesis from the reduced per-band inputs
    (on-line zeros, edge clearance at the two edges, five enclosures). -/
theorem bandHyp_of_reduced (hin : ∀ i, i < 25 → (seg i).ReducedInputs (capLo i) (capHi i)) :
    AllZeros_h1000.BandHyp :=
  segBandHyp_of_reduced seg seg_edge seg_stmt seg_geom hin

/-- The height-1000 ladder statement from the per-band Arb inputs and the height floor. -/
theorem all_nontrivial_zeros_up_to_height_1000_of_inputs
    (hin : ∀ i, i < 25 → (seg i).Inputs)
    (hγ : ∀ ρ : ℂ, riemannZeta ρ = 0 → 0 < ρ.im → ρ.im ≤ 1000 → 55 / 16 ≤ |ρ.im|) :
    ∀ ρ : ℂ, riemannZeta ρ = 0 → 0 < ρ.im → ρ.im ≤ 1000 → ρ.re = 1 / 2 :=
  AllZeros_h1000.all_nontrivial_zeros_up_to_height_1000_of_bands (bandHyp_of_inputs hin) hγ

/-- The height-1000 ladder statement from the K1-reduced per-band inputs and the height floor. -/
theorem all_nontrivial_zeros_up_to_height_1000_of_reduced
    (hin : ∀ i, i < 25 → (seg i).ReducedInputs (capLo i) (capHi i))
    (hγ : ∀ ρ : ℂ, riemannZeta ρ = 0 → 0 < ρ.im → ρ.im ≤ 1000 → 55 / 16 ≤ |ρ.im|) :
    ∀ ρ : ℂ, riemannZeta ρ = 0 → 0 < ρ.im → ρ.im ≤ 1000 → ρ.re = 1 / 2 :=
  AllZeros_h1000.all_nontrivial_zeros_up_to_height_1000_of_bands (bandHyp_of_reduced hin) hγ

