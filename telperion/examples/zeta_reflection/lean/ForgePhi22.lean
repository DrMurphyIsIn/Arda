/-! ## Generic per-term brackets (proved once) -/

/-- `arctan u + arctan((1-u)/(1+u)) = pi/4` for `u >= 0`. -/
theorem arctan_add_quarter {u : ℝ} (hu : 0 ≤ u) :
    Real.arctan u + Real.arctan ((1 - u) / (1 + u)) = Real.pi / 4 := by
  have h1u : 0 < 1 + u := by linarith
  set w : ℝ := (1 - u) / (1 + u) with hw
  have hwu : w * (1 + u) = 1 - u := by rw [hw]; field_simp
  have hsum : (u + w) * (1 + u) = 1 + u ^ 2 := by linear_combination hwu
  have hpos : 0 < u + w := by
    by_contra hneg
    have hneg' : u + w ≤ 0 := not_lt.mp hneg
    have : (u + w) * (1 + u) ≤ 0 := mul_nonpos_of_nonpos_of_nonneg hneg' (le_of_lt h1u)
    nlinarith [sq_nonneg u]
  have hprod : u * w < 1 := by nlinarith [hwu, hpos]
  rw [Real.arctan_add hprod]
  have hden : 1 - u * w = u + w := by linear_combination -hwu
  rw [hden, div_self (ne_of_gt hpos), Real.arctan_one]

/-- Direct Taylor bracket for a term `arctan(11/(1/4+k))` with argument `u <= 1`. -/
theorem at_direct {k : ℕ} {u lo hi : ℝ} (N : ℕ)
    (hu : (11:ℝ) / (1/4 + (k:ℝ)) = u) (hu0 : 0 ≤ u)
    (hlo : lo ≤ ArctanTaylor.atanPS u N - u^(2*N+1)/(2*N+1))
    (hhi : ArctanTaylor.atanPS u N + u^(2*N+1)/(2*N+1) ≤ hi) :
    lo ≤ Real.arctan (11 / (1/4 + (k:ℝ))) ∧ Real.arctan (11 / (1/4 + (k:ℝ))) ≤ hi := by
  rw [hu]
  have h := ArctanTaylor.arctan_bracket u hu0 N
  rw [abs_le] at h
  constructor <;> linarith [h.1, h.2]

/-- Reflected bracket: `arctan(11/(1/4+k)) = pi/2 - arctan u`, `u = (1/4+k)/11`. -/
theorem at_reflA {k : ℕ} {u lo hi : ℝ} (N : ℕ)
    (hu : (1/4 + (k:ℝ)) / 11 = u) (hu0 : 0 < u)
    (hlo : lo ≤ -(ArctanTaylor.atanPS u N + u^(2*N+1)/(2*N+1)))
    (hhi : -(ArctanTaylor.atanPS u N - u^(2*N+1)/(2*N+1)) ≤ hi) :
    Real.pi / 2 + lo ≤ Real.arctan (11 / (1/4 + (k:ℝ)))
      ∧ Real.arctan (11 / (1/4 + (k:ℝ))) ≤ Real.pi / 2 + hi := by
  have hinv : (11:ℝ) / (1/4 + (k:ℝ)) = u⁻¹ := by rw [← hu, inv_div]
  rw [hinv, Real.arctan_inv_of_pos hu0]
  have h := ArctanTaylor.arctan_bracket u (le_of_lt hu0) N
  rw [abs_le] at h
  constructor <;> linarith [h.1, h.2]

/-- Reflected + quarter-shifted bracket: `arctan(11/(1/4+k)) = pi/4 + arctan w`,
    `u = (1/4+k)/11`, `w = (1-u)/(1+u)`. -/
theorem at_shiftA {k : ℕ} {u w lo hi : ℝ} (N : ℕ)
    (hu : (1/4 + (k:ℝ)) / 11 = u) (hu0 : 0 < u) (hw : (1 - u) / (1 + u) = w) (hw0 : 0 ≤ w)
    (hlo : lo ≤ ArctanTaylor.atanPS w N - w^(2*N+1)/(2*N+1))
    (hhi : ArctanTaylor.atanPS w N + w^(2*N+1)/(2*N+1) ≤ hi) :
    Real.pi / 4 + lo ≤ Real.arctan (11 / (1/4 + (k:ℝ)))
      ∧ Real.arctan (11 / (1/4 + (k:ℝ))) ≤ Real.pi / 4 + hi := by
  have hinv : (11:ℝ) / (1/4 + (k:ℝ)) = u⁻¹ := by rw [← hu, inv_div]
  rw [hinv, Real.arctan_inv_of_pos hu0]
  have hq := arctan_add_quarter (le_of_lt hu0)
  rw [hw] at hq
  have h := ArctanTaylor.arctan_bracket w hw0 N
  rw [abs_le] at h
  constructor <;> linarith [h.1, h.2]

/-- Quarter-shifted bracket: `arctan(11/(1/4+k)) = pi/4 - arctan w`, `v = 11/(1/4+k)`,
    `w = (1-v)/(1+v)`. -/
theorem at_shiftB {k : ℕ} {v w lo hi : ℝ} (N : ℕ)
    (hv : (11:ℝ) / (1/4 + (k:ℝ)) = v) (hv0 : 0 ≤ v) (hw : (1 - v) / (1 + v) = w) (hw0 : 0 ≤ w)
    (hlo : lo ≤ -(ArctanTaylor.atanPS w N + w^(2*N+1)/(2*N+1)))
    (hhi : -(ArctanTaylor.atanPS w N - w^(2*N+1)/(2*N+1)) ≤ hi) :
    Real.pi / 4 + lo ≤ Real.arctan (11 / (1/4 + (k:ℝ)))
      ∧ Real.arctan (11 / (1/4 + (k:ℝ))) ≤ Real.pi / 4 + hi := by
  rw [hv]
  have hq := arctan_add_quarter hv0
  rw [hw] at hq
  have h := ArctanTaylor.arctan_bracket w hw0 N
  rw [abs_le] at h
  constructor <;> linarith [h.1, h.2]

/-- Enclosure addition. -/
theorem encl_add {S f A B a b : ℝ} (hS : A ≤ S ∧ S ≤ B) (hf : a ≤ f ∧ f ≤ b) :
    A + a ≤ S + f ∧ S + f ≤ B + b :=
  ⟨add_le_add hS.1 hf.1, add_le_add hS.2 hf.2⟩

/-- The fold step on `Finset.range` sums (keeps the partial sum as a `Finset.sum`, so no large
    syntactic sum has to be matched against the goal). -/
theorem sum_encl_succ (f : ℕ → ℝ) (n : ℕ) {A B a b : ℝ}
    (hS : A ≤ ∑ k ∈ Finset.range n, f k ∧ ∑ k ∈ Finset.range n, f k ≤ B)
    (hf : a ≤ f n ∧ f n ≤ b) :
    A + a ≤ ∑ k ∈ Finset.range (n + 1), f k ∧ ∑ k ∈ Finset.range (n + 1), f k ≤ B + b := by
  rw [Finset.sum_range_succ]
  exact encl_add hS hf

