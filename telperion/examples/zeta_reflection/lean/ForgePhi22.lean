/-! ## imLnVal (1/4) 11 128, the phase box, and the two sign facts -/

/-- `log 128 = 7 log 2` bracket from the Mathlib d9 constants. -/
theorem log128box : (((48520302621 : ℝ) / 10000000000)) ≤ Real.log ((128:ℕ):ℝ) ∧ Real.log ((128:ℕ):ℝ) ≤ (((758129729 : ℝ) / 156250000)) := by
  have h : Real.log ((128:ℕ):ℝ) = 7 * Real.log 2 := by
    rw [show ((128:ℕ):ℝ) = (2:ℝ) ^ 7 by norm_num, Real.log_pow]; norm_num
  rw [h]
  constructor <;> linarith [Real.log_two_gt_d9, Real.log_two_lt_d9]

/-- **The Euler-route partial value** `imLnVal (1/4) 11 128`. -/
theorem imbox : ((2442436068778979 : ℝ) / 163840000000000) ≤ imLnVal (1/4) 11 128 ∧ imLnVal (1/4) 11 128 ≤ ((39079002401424729 : ℝ) / 2621440000000000) := by
  obtain ⟨hs1, hs2⟩ := sumbox
  obtain ⟨hl1, hl2⟩ := log128box
  have hp1 := Real.pi_gt_d6
  have hp2 := Real.pi_lt_d6
  have hexp : imLnVal (1/4) 11 128
      = 11 * Real.log ((128:ℕ):ℝ) - ∑ k ∈ Finset.range (128 + 1), Real.arctan (11 / (1/4 + (k:ℝ))) := by
    unfold imLnVal; rfl
  rw [hexp]
  constructor <;> linarith

/-- **The phase box at `t = 22`.**  For the theta-limit `Lam` of `imLnVal (1/4) 11`,
    `1023/500 <= Lam - 11 log pi <= 517/200`  (rate `<= 0.2690` at n0 = 128). -/
theorem phibox (Λ : ℝ) (hΛ : Filter.Tendsto (imLnVal (1/4) 11) Filter.atTop (nhds Λ)) :
    ((1023 : ℝ) / 500) ≤ Λ - 11 * Real.log Real.pi ∧ Λ - 11 * Real.log Real.pi ≤ ((517 : ℝ) / 200) := by
  have hrate : |Λ - imLnVal (1/4) 11 128| ≤ ((6611 : ℝ) / 24576) :=
    le_trans (ForgeRate.rate_at (1/4) 11 (by norm_num) Λ hΛ 128 (by norm_num)) (by norm_num)
  rw [abs_le] at hrate
  obtain ⟨hi1, hi2⟩ := imbox
  obtain ⟨hlp1, hlp2⟩ := ForgeThetaBox.logpibox
  constructor <;> linarith [hrate.1, hrate.2]

/-- **The two sign facts at `t = 22`.**  `cos phi <= 0` and `sin phi >= 7/20`, from
    `pi/2 < phi < pi` (the phase box) and Jordan's inequality `sin x >= (2/pi) x` on `[0, pi/2]`. -/
theorem cossin22 (Λ : ℝ) (hΛ : Filter.Tendsto (imLnVal (1/4) 11) Filter.atTop (nhds Λ)) :
    Real.cos (Λ - 11 * Real.log Real.pi) ≤ 0
      ∧ ((7 : ℝ) / 20) ≤ Real.sin (Λ - 11 * Real.log Real.pi) := by
  obtain ⟨hφlo, hφhi⟩ := phibox Λ hΛ
  set φ : ℝ := Λ - 11 * Real.log Real.pi with hφ
  have hp1 := Real.pi_gt_d6
  have hp2 := Real.pi_lt_d6
  refine ⟨Real.cos_nonpos_of_pi_div_two_le_of_le (by linarith) (by linarith), ?_⟩
  have hx0 : 0 ≤ Real.pi - φ := by linarith
  have hx1 : Real.pi - φ ≤ Real.pi / 2 := by linarith
  have hj := Real.mul_le_sin hx0 hx1
  rw [Real.sin_pi_sub] at hj
  have hpipos : 0 < Real.pi := Real.pi_pos
  have h2pi : (2 : ℝ) / 3.141593 ≤ 2 / Real.pi :=
    div_le_div_of_nonneg_left (by norm_num) hpipos (le_of_lt hp2)
  have hxlo : ((34787 : ℝ) / 62500) ≤ Real.pi - φ := by linarith
  have hprod : (2 : ℝ) / 3.141593 * ((34787 : ℝ) / 62500) ≤ 2 / Real.pi * (Real.pi - φ) :=
    mul_le_mul h2pi hxlo (by norm_num) (by positivity)
  have hnum : ((7 : ℝ) / 20) ≤ (2 : ℝ) / 3.141593 * ((34787 : ℝ) / 62500) := by norm_num
  linarith

end ForgePhi22

