noncomputable def E0 : EnclQ := ⟨Q.frac (-249) 250, Q.frac 249 250, Arb4.H1000.E_T41.Lo, Arb4.H1000.E_T41.Hi, Arb4.H1000.E_T1.Lo, Arb4.H1000.E_T1.Hi,
  (Q.frac 9976159937 500000000), (Q.frac 20214507747 1000000000), (Q.frac 19509725093 1000000000), (Q.frac 9810945633 500000000)⟩

theorem chk0 : (validB (Q.ofNat 1) (Q.ofNat 41) (Q.ofNat 21) (Q.frac 6437 16) 7 E0 && k6sideB G_T1 G_T41 E0) = true := by decide +kernel

theorem box0 : BandGlue.BoxCert (1 / 4000000) (3999999 / 4000000) (AllZeros_h1000.bLo 0) (AllZeros_h1000.bHi 0) := by
  have hc := chk0
  rw [Bool.and_eq_true] at hc
  have hT0 : (BandGlue_h1000.seg 0).T0 = (Q.ofNat 1).val := Q.cv_one.symm
  have hT1 : (BandGlue_h1000.seg 0).T1 = (Q.ofNat 41).val := (Q.cv_nat 41).symm
  have hcc : (BandGlue_h1000.seg 0).c = (⟨1 / 2, (Q.ofNat 21).val⟩ : ℂ) := by rw [(Q.cv_nat 21)]; rfl
  have hR : (BandGlue_h1000.seg 0).R = Real.sqrt (Q.frac 6437 16).val := by rw [(Q.cv_frac 6437 16)]; rfl
  refine boxCert_of_parts (BandGlue_h1000.seg 0) E0 (BandGlue_h1000.seg_edge 0 (by norm_num)).1
    (BandGlue_h1000.seg_edge 0 (by norm_num)).2 (valid_of_B _ _ _ _ _ E0 hT0 hT1 hcc hR hc.1)
    (BandGlue_h1000.seg_geom 0 (by norm_num)) ?_ ?_ ?_ (k6side_of_B _ G_T1 G_T41 E0 hT0 hT1 hc.2) ?_ ?_
  · exact Arb4.H1000.B00_line
  · exact H1000Line.slab0_band0
  · show EdgeClearGlue.SlabClear (41 : ℝ) ((41 : ℝ) + 5773 / 100000)
    exact Arb4.H1000.S_U41_clear
  · show DiffractionCore.argChangeHoriz riemannZeta (41 : ℝ) 2 (-1) ∈ Set.Icc (Arb4.H1000.E_T41.Lo).val (Arb4.H1000.E_T41.Hi).val
    exact Arb4.H1000.E_T41_hAH
  · show DiffractionCore.argChangeHoriz riemannZeta (1 : ℝ) 2 (-1) ∈ Set.Icc (Arb4.H1000.E_T1.Lo).val (Arb4.H1000.E_T1.Hi).val
    exact Arb4.H1000.E_T1_hAH

