/-- The five enclosures of band 0: K6a, the edges at 4040 and 4000, K6b. -/
noncomputable def E0 : EnclQ := ⟨Q.frac (-249) 250, Q.frac 249 250, Arb4.H5000.E_T4040.Lo, Arb4.H5000.E_T4040.Hi, Arb4.H5000.E_T4000.Lo, Arb4.H5000.E_T4000.Hi,
  (Q.frac 12922299789 100000000), (Q.frac 25844649331 200000000), (Q.frac 64611498017 500000000), (Q.frac 64611622399 500000000)⟩

theorem chk0 : (validB (Q.ofNat 4000) (Q.ofNat 4040) (Q.ofNat 4020) (Q.frac 6437 16) 42 E0 && k6sideB G_T4000 G_T4040 E0) = true := by decide +kernel

theorem box0 : BandGlue.BoxCert (1 / 4000000) (3999999 / 4000000) (AllZeros_h5000.bLo 0) (AllZeros_h5000.bHi 0) := by
  have hc := chk0
  rw [Bool.and_eq_true] at hc
  have hT0 : (Arb4.BandGlue_h5000.seg 0).T0 = (Q.ofNat 4000).val := (Q.cv_nat 4000).symm
  have hT1 : (Arb4.BandGlue_h5000.seg 0).T1 = (Q.ofNat 4040).val := (Q.cv_nat 4040).symm
  have hcc : (Arb4.BandGlue_h5000.seg 0).c = (⟨1 / 2, (Q.ofNat 4020).val⟩ : ℂ) := by rw [(Q.cv_nat 4020)]; rfl
  have hR : (Arb4.BandGlue_h5000.seg 0).R = Real.sqrt (Q.frac 6437 16).val := by rw [(Q.cv_frac 6437 16)]; rfl
  refine boxCert_of_parts (Arb4.BandGlue_h5000.seg 0) E0 (Arb4.BandGlue_h5000.seg_edge 0 (by norm_num)).1
    (Arb4.BandGlue_h5000.seg_edge 0 (by norm_num)).2 (valid_of_B _ _ _ _ _ E0 hT0 hT1 hcc hR hc.1)
    (Arb4.BandGlue_h5000.seg_geom 0 (by norm_num)) ?_ ?_ ?_ (k6side_of_B _ G_T4000 G_T4040 E0 hT0 hT1 hc.2) ?_ ?_
  · exact Arb4.H5000.B00_line
  · show EdgeClearGlue.SlabClear ((4000 : ℝ) - 5773 / 100000) (4000 : ℝ)
    exact Arb4.H5000.S_L4000_clear
  · show EdgeClearGlue.SlabClear (4040 : ℝ) ((4040 : ℝ) + 5773 / 100000)
    exact Arb4.H5000.S_U4040_clear
  · show DiffractionCore.argChangeHoriz riemannZeta (4040 : ℝ) 2 (-1) ∈ Set.Icc (Arb4.H5000.E_T4040.Lo).val (Arb4.H5000.E_T4040.Hi).val
    exact Arb4.H5000.E_T4040_hAH
  · show DiffractionCore.argChangeHoriz riemannZeta (4000 : ℝ) 2 (-1) ∈ Set.Icc (Arb4.H5000.E_T4000.Lo).val (Arb4.H5000.E_T4000.Hi).val
