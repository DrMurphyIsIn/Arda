/-- `10^(-5/2) <= 1/316`  (`sqrt 10 >= 3.16`, `10^2 * sqrt 10 >= 316`). -/
private theorem pow10_le : (10 : ℝ) ^ (-(5 / 2 : ℝ)) ≤ 1 / 316 := by
  have hsqrt : (3.16 : ℝ) ≤ (10 : ℝ) ^ (1 / 2 : ℝ) := by
    rw [← Real.sqrt_eq_rpow,
      show (3.16 : ℝ) = Real.sqrt (3.16 ^ 2) by rw [Real.sqrt_sq (by norm_num)]]
    apply Real.sqrt_le_sqrt; norm_num
  rw [Real.rpow_neg (by norm_num), show (5 / 2 : ℝ) = 2 + 1 / 2 by norm_num,
    Real.rpow_add (by norm_num), Real.rpow_two]
  have hden_ge : (316 : ℝ) ≤ (10 : ℝ) ^ 2 * (10 : ℝ) ^ (1 / 2 : ℝ) := by
    calc (316 : ℝ) = 100 * 3.16 := by norm_num
      _ ≤ (10 : ℝ) ^ 2 * (10 : ℝ) ^ (1 / 2 : ℝ) := by gcongr; norm_num
  calc ((10 : ℝ) ^ 2 * (10 : ℝ) ^ (1 / 2 : ℝ))⁻¹
      ≤ (316 : ℝ)⁻¹ := inv_anti₀ (by norm_num) hden_ge
    _ = 1 / 316 := by rw [one_div]

/-- `|(a:ℂ) + b i| <= R` whenever `a^2 + b^2 <= R^2`, `0 <= R`. -/
private theorem norm_le' {a b R : ℝ} (hR : 0 ≤ R) (hab : a ^ 2 + b ^ 2 ≤ R ^ 2) :
    ‖(a : ℂ) + b * Complex.I‖ ≤ R := by
  rw [Complex.norm_add_mul_I,
    show R = Real.sqrt (R ^ 2) by rw [Real.sqrt_sq hR]]
  exact Real.sqrt_le_sqrt hab

