    rw [show ((1 / 2 : ℂ) + 22 * Complex.I + 1) = ((3/2 : ℝ) : ℂ) + (22 : ℝ) * Complex.I by push_cast; ring]
    exact norm_le' (by norm_num) (by norm_num)
