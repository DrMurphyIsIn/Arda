            * ‖((1 / 2 : ℂ) + 22 * Complex.I + 2)‖ := by rw [norm_mul, norm_mul]
      _ ≤ 23 * 23 * 23 := by gcongr
      _ = 12167 := by norm_num
  have hpownn : (0 : ℝ) ≤ (10 : ℝ) ^ (-(5 / 2 : ℝ)) := Real.rpow_nonneg (by norm_num) _
