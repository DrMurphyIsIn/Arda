  have hnorm : ‖((1 / 2 : ℂ) + 22 * Complex.I) * ((1 / 2 : ℂ) + 22 * Complex.I + 1)
        * ((1 / 2 : ℂ) + 22 * Complex.I + 2)‖ ≤ 12167 := by
