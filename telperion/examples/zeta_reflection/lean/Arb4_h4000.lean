/-! ### Band 0: `[3000, 3040]`, 39 zeros -/

/-- The five enclosures of band 0: K6a, the edges at 3040 and 3000, K6b. -/
noncomputable def E0 : EnclQ := ⟨Q.frac (-249) 250, Q.frac 249 250, Arb4.H4000.E_T3040.Lo, Arb4.H4000.E_T3040.Hi, Arb4.H3000.E_T3000.Lo, Arb4.H3000.E_T3000.Hi,
  (Q.frac 247004787 2000000), (Q.frac 61751362321 500000000), (Q.frac 12350239021 100000000), (Q.frac 15437840169 125000000)⟩

theorem chk0 : (validB (Q.ofNat 3000) (Q.ofNat 3040) (Q.ofNat 3020) (Q.frac 6437 16) 39 E0 && k6sideB G_T3000 G_T3040 E0) = true := by decide +kernel

theorem box0 : BandGlue.BoxCert (1 / 4000000) (3999999 / 4000000) (AllZeros_h4000.bLo 0) (AllZeros_h4000.bHi 0) := by
  have hc := chk0
  rw [Bool.and_eq_true] at hc
  have hT0 : (Arb4.BandGlue_h4000.seg 0).T0 = (Q.ofNat 3000).val := (Q.cv_nat 3000).symm
  have hT1 : (Arb4.BandGlue_h4000.seg 0).T1 = (Q.ofNat 3040).val := (Q.cv_nat 3040).symm
  have hcc : (Arb4.BandGlue_h4000.seg 0).c = (⟨1 / 2, (Q.ofNat 3020).val⟩ : ℂ) := by rw [(Q.cv_nat 3020)]; rfl
  have hR : (Arb4.BandGlue_h4000.seg 0).R = Real.sqrt (Q.frac 6437 16).val := by rw [(Q.cv_frac 6437 16)]; rfl
  refine boxCert_of_parts (Arb4.BandGlue_h4000.seg 0) E0 (Arb4.BandGlue_h4000.seg_edge 0 (by norm_num)).1
    (Arb4.BandGlue_h4000.seg_edge 0 (by norm_num)).2 (valid_of_B _ _ _ _ _ E0 hT0 hT1 hcc hR hc.1)
    (Arb4.BandGlue_h4000.seg_geom 0 (by norm_num)) ?_ ?_ ?_ (k6side_of_B _ G_T3000 G_T3040 E0 hT0 hT1 hc.2) ?_ ?_
  · exact Arb4.H4000.B00_line
  · show EdgeClearGlue.SlabClear ((3000 : ℝ) - 5773 / 100000) (3000 : ℝ)
    exact Arb4.H4000.S_L3000_clear
  · show EdgeClearGlue.SlabClear (3040 : ℝ) ((3040 : ℝ) + 5773 / 100000)
    exact Arb4.H4000.S_U3040_clear
  · show DiffractionCore.argChangeHoriz riemannZeta (3040 : ℝ) 2 (-1) ∈ Set.Icc (Arb4.H4000.E_T3040.Lo).val (Arb4.H4000.E_T3040.Hi).val
    exact Arb4.H4000.E_T3040_hAH
  · show DiffractionCore.argChangeHoriz riemannZeta (3000 : ℝ) 2 (-1) ∈ Set.Icc (Arb4.H3000.E_T3000.Lo).val (Arb4.H3000.E_T3000.Hi).val
    exact Arb4.H3000.E_T3000_hAH

