theorem boxCert_of_inputs (i : ℕ) (hi : i < 25) (hin : (seg i).Inputs) :
    BoxCert (1 / 4000000) (3999999 / 4000000) (AllZeros_h6000.bLo i) (AllZeros_h6000.bHi i) :=
  BoxCert.of_stmt (seg i) (seg_edge i hi).1 (seg_edge i hi).2 (seg_stmt i hi) hin

/-- **K0 on `AllZeros_h6000`**: the segment's band hypothesis from the per-band Arb inputs
    (`hLine`, `hArbT` of each band theorem), composed through the real `rh_in_box_*` theorems. -/
theorem bandHyp_of_inputs (hin : ∀ i, i < 25 → (seg i).Inputs) : AllZeros_h6000.BandHyp :=
  segBandHyp_of_bands seg seg_edge seg_stmt hin

/-- **K0 + K1 on `AllZeros_h6000`**: the segment's band hypothesis from the reduced per-band inputs
