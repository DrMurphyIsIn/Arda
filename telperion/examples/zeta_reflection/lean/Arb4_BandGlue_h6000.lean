theorem bandHyp_of_reduced (hin : ∀ i, i < 25 → (seg i).ReducedInputs (capLo i) (capHi i)) :
    AllZeros_h6000.BandHyp :=
  segBandHyp_of_reduced seg seg_edge seg_stmt seg_geom hin

