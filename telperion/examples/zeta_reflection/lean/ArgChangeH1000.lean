/-- **K0 + K1 + K6 on `AllZeros_h1000`**: the segment's band hypothesis from the K6-reduced
    per-band inputs (on-line zeros, two zero-free edge slabs, the two horizontal enclosures). -/
theorem bandHyp_of_K6 (hin : ∀ i, i < 25 →
    ArgChangeGlue.K6Inputs (BandGlue_h1000.capLo i) (BandGlue_h1000.capHi i) (segK i)) :
    AllZeros_h1000.BandHyp :=
  ArgChangeGlue.segBandHyp_of_K6 segK segK_edge segK_stmt segK_geom segK_side hin

/-- **The height-1000 statement from the K6-reduced inputs alone** (the height floor `hγ` is
    discharged by `HeightFloor.height_floor`). -/
theorem all_nontrivial_zeros_up_to_height_1000_of_K6 (hin : ∀ i, i < 25 →
    ArgChangeGlue.K6Inputs (BandGlue_h1000.capLo i) (BandGlue_h1000.capHi i) (segK i)) :
    ∀ ρ : ℂ, riemannZeta ρ = 0 → 0 < ρ.im → ρ.im ≤ 1000 → ρ.re = 1 / 2 :=
  AllZeros_h1000.all_nontrivial_zeros_up_to_height_1000_of_bands (bandHyp_of_K6 hin)
    (HeightFloor.height_floor 1000)

/-- The K1-reduced inputs of the Arb bands (`BandGlue_h1000`) imply the K6-reduced inputs: K6 only
    DROPS conjuncts (the horizontal enclosures are the Arb band's own). -/
theorem k6Inputs_of_reduced (i : ℕ) (h : (BandGlue_h1000.seg i).ReducedInputs (BandGlue_h1000.capLo i)
    (BandGlue_h1000.capHi i)) : ArgChangeGlue.K6Inputs (BandGlue_h1000.capLo i) (BandGlue_h1000.capHi i) (segK i) :=
  ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.2.1, h.2.2.2.2.2.1⟩

end ArgChangeH1000
