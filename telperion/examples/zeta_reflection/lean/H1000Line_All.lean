/-- `hLine` depends on a band only through `T0`, `T1`, `n`. -/
theorem lineHyp_of_edges (i : ℕ) (hi : i < 25) (d : BandGlue.BandData)
    (h0 : d.T0 = (BandGlue_h1000.seg i).T0) (h1 : d.T1 = (BandGlue_h1000.seg i).T1)
    (hn : d.n = (BandGlue_h1000.seg i).n) : d.LineHyp := by
  have h := seg_lineHyp i hi
  unfold BandGlue.BandData.LineHyp at h ⊢
  rw [h0, h1, hn]
  exact h

/-- **The height-1000 ladder statement from the OFF-LINE inputs only.**  `hLine` of all 25 bands
    (this lane) and the height floor `hγ` (`HeightFloor.height_floor`) are discharged; what remains
    per band is the edge clearance below `T0` and above `T1` (heights `capLo i`, `capHi i`) and the
    five RvM argument-change enclosures `EnclHyp`. -/
theorem all_nontrivial_zeros_up_to_height_1000_of_offline
    (hslab0 : ∀ i, i < 25 → EdgeClearGlue.SlabClear ((BandGlue_h1000.seg i).T0 - BandGlue_h1000.capLo i)
      (BandGlue_h1000.seg i).T0)
    (hslab1 : ∀ i, i < 25 → EdgeClearGlue.SlabClear (BandGlue_h1000.seg i).T1
      ((BandGlue_h1000.seg i).T1 + BandGlue_h1000.capHi i))
    (henc : ∀ i, i < 25 → (BandGlue_h1000.seg i).EnclHyp) :
    ∀ ρ : ℂ, riemannZeta ρ = 0 → 0 < ρ.im → ρ.im ≤ 1000 → ρ.re = 1 / 2 :=
  BandGlue_h1000.all_nontrivial_zeros_up_to_height_1000_of_reduced
    (fun i hi => ⟨seg_lineHyp i hi, hslab0 i hi, hslab1 i hi, henc i hi⟩)
    (HeightFloor.height_floor 1000)

/-- **The certificate route.**  The integration stage may re-choose each band's enclosure data
    (e.g. wider kernel-provable enclosures, as long as the pins of `Valid` hold) and ball geometry:
    for every band, ANY `BandGlue.BandData` with the segment band's `T0`, `T1`, `n`, its decidable
    side conditions `Valid`, the K1 cap geometry, the two edge-clearance slabs and ITS five
    enclosures gives the band's box claim, `hLine` being supplied by this lane and `hγ` by
    `HeightFloor`. -/
theorem all_nontrivial_zeros_up_to_height_1000_of_certs
    (hcert : ∀ i, i < 25 → ∃ d : BandGlue.BandData, ∃ δ0 δ1 : ℝ,
      d.T0 = (BandGlue_h1000.seg i).T0 ∧ d.T1 = (BandGlue_h1000.seg i).T1 ∧
      d.n = (BandGlue_h1000.seg i).n ∧ d.Valid (1 / 4000000) (3999999 / 4000000) ∧
      d.CapGeom δ0 δ1 ∧ EdgeClearGlue.SlabClear (d.T0 - δ0) d.T0 ∧
      EdgeClearGlue.SlabClear d.T1 (d.T1 + δ1) ∧ d.EnclHyp) :
    ∀ ρ : ℂ, riemannZeta ρ = 0 → 0 < ρ.im → ρ.im ≤ 1000 → ρ.re = 1 / 2 := by
  apply AllZeros_h1000.all_nontrivial_zeros_up_to_height_1000_of_bands _ (HeightFloor.height_floor 1000)
  intro i hi
  obtain ⟨d, δ0, δ1, h0, h1, hn, hV, hG, hs0, hs1, hE⟩ := hcert i hi
  have hL : d.LineHyp := lineHyp_of_edges i hi d h0 h1 hn
  have hc : BandGlue.BoxCert (1 / 4000000) (3999999 / 4000000) (AllZeros_h1000.bLo i)
      (AllZeros_h1000.bHi i) :=
    BandGlue.BoxCert.of_valid d (by rw [h0]; exact (BandGlue_h1000.seg_edge i hi).1)
      (by rw [h1]; exact (BandGlue_h1000.seg_edge i hi).2) hV
      (BandGlue.BandData.inputs_of_reduced hG ⟨hL, hs0, hs1, hE⟩)
  exact hc.box

