/-- **`hLine` of every band of `AllZeros_h1000`**, kernel-checked (no hypotheses). -/
theorem seg_lineHyp : ∀ i, i < 25 → (BandGlue_h1000.seg i).LineHyp := by
  intro i hi
  interval_cases i
  · exact H1000Line.B00.lineHyp
  · exact H1000Line.B01.lineHyp
