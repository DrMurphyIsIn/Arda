/-- **THE INTEGRATION TARGET: the height-1000 ladder statement from the off-line facts only.**
    Per band `i < 25`: enclosure data `E i` with its two pins (`PinOk`, decidable), its five RvM
    enclosures (`(segWith i (E i)).EnclHyp`), the edge clearance above `T1` (`hslab1`) and, for
    `i ≥ 1`, below `T0` (`hslab0`; band 0's lower slab is `slab0_band0`).  `hLine` (this lane),
    `hnzl` (EdgeClearGlue), `hγ` (HeightFloor), the ball geometry and the band statements are
    all discharged. -/
theorem all_nontrivial_zeros_up_to_height_1000_of_encl (E : ℕ → Encl)
    (hpin : ∀ i, i < 25 → PinOk i (E i))
    (henc : ∀ i, i < 25 → (segWith i (E i)).EnclHyp)
    (hslab0 : ∀ i, 1 ≤ i → i < 25 → EdgeClearGlue.SlabClear
      ((BandGlue_h1000.seg i).T0 - BandGlue_h1000.capLo i) (BandGlue_h1000.seg i).T0)
    (hslab1 : ∀ i, i < 25 → EdgeClearGlue.SlabClear (BandGlue_h1000.seg i).T1
      ((BandGlue_h1000.seg i).T1 + BandGlue_h1000.capHi i)) :
    ∀ ρ : ℂ, riemannZeta ρ = 0 → 0 < ρ.im → ρ.im ≤ 1000 → ρ.re = 1 / 2 := by
  apply all_nontrivial_zeros_up_to_height_1000_of_certs
  intro i hi
  have hs0 : EdgeClearGlue.SlabClear ((BandGlue_h1000.seg i).T0 - BandGlue_h1000.capLo i)
      (BandGlue_h1000.seg i).T0 := by
    rcases Nat.eq_zero_or_pos i with h | h
    · subst h; exact slab0_band0
    · exact hslab0 i h hi
  exact ⟨segWith i (E i), BandGlue_h1000.capLo i, BandGlue_h1000.capHi i, rfl, rfl, rfl,
    segWith_valid i hi (E i) (hpin i hi), capGeom_segWith (E i) (BandGlue_h1000.seg_geom i hi),
    hs0, hslab1 i hi, henc i hi⟩

end H1000Line
