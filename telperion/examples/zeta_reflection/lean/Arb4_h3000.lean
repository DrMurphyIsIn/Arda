  (Q.frac 115458949959 1000000000), (Q.frac 57729722529 500000000), (Q.frac 57729471303 500000000), (Q.frac 23091887541 200000000)⟩

theorem chk0 : (validB (Q.ofNat 2000) (Q.ofNat 2040) (Q.ofNat 2020) (Q.frac 6437 16) 37 E0 && k6sideB G_T2000 G_T2040 E0) = true := by decide +kernel

theorem box0 : BandGlue.BoxCert (1 / 4000000) (3999999 / 4000000) (AllZeros_h3000.bLo 0) (AllZeros_h3000.bHi 0) := by
  have hc := chk0
  rw [Bool.and_eq_true] at hc
  have hT0 : (Arb4.BandGlue_h3000.seg 0).T0 = (Q.ofNat 2000).val := (Q.cv_nat 2000).symm
  have hT1 : (Arb4.BandGlue_h3000.seg 0).T1 = (Q.ofNat 2040).val := (Q.cv_nat 2040).symm
  have hcc : (Arb4.BandGlue_h3000.seg 0).c = (⟨1 / 2, (Q.ofNat 2020).val⟩ : ℂ) := by rw [(Q.cv_nat 2020)]; rfl
  have hR : (Arb4.BandGlue_h3000.seg 0).R = Real.sqrt (Q.frac 6437 16).val := by rw [(Q.cv_frac 6437 16)]; rfl
  refine boxCert_of_parts (Arb4.BandGlue_h3000.seg 0) E0 (Arb4.BandGlue_h3000.seg_edge 0 (by norm_num)).1
    (Arb4.BandGlue_h3000.seg_edge 0 (by norm_num)).2 (valid_of_B _ _ _ _ _ E0 hT0 hT1 hcc hR hc.1)
    (Arb4.BandGlue_h3000.seg_geom 0 (by norm_num)) ?_ ?_ ?_ (k6side_of_B _ G_T2000 G_T2040 E0 hT0 hT1 hc.2) ?_ ?_
  · exact Arb4.H3000.B00_line
  · show EdgeClearGlue.SlabClear ((2000 : ℝ) - 5773 / 100000) (2000 : ℝ)
    exact Arb4.H3000.S_L2000_clear
  · show EdgeClearGlue.SlabClear (2040 : ℝ) ((2040 : ℝ) + 5773 / 100000)
    exact Arb4.H3000.S_U2040_clear
  · show DiffractionCore.argChangeHoriz riemannZeta (2040 : ℝ) 2 (-1) ∈ Set.Icc (Arb4.H3000.E_T2040.Lo).val (Arb4.H3000.E_T2040.Hi).val
