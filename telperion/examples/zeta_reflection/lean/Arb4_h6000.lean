  · show EdgeClearGlue.SlabClear ((5000 : ℝ) - 5773 / 100000) (5000 : ℝ)
    exact Arb4.H6000.S_L5000_clear
  · show EdgeClearGlue.SlabClear (5040 : ℝ) ((5040 : ℝ) + 5773 / 100000)
    exact Arb4.H6000.S_U5040_clear
  · show DiffractionCore.argChangeHoriz riemannZeta (5040 : ℝ) 2 (-1) ∈ Set.Icc (Arb4.H6000.E_T5040.Lo).val (Arb4.H6000.E_T5040.Hi).val
