  (Q.frac 133666011999 1000000000), (Q.frac 16708276401 125000000), (Q.frac 133666010809 1000000000), (Q.frac 133666210017 1000000000)⟩

theorem chk0 : (validB (Q.ofNat 5000) (Q.ofNat 5040) (Q.ofNat 5020) (Q.frac 6437 16) 43 E0 && k6sideB G_T5000 G_T5040 E0) = true := by decide +kernel

theorem box0 : BandGlue.BoxCert (1 / 4000000) (3999999 / 4000000) (AllZeros_h6000.bLo 0) (AllZeros_h6000.bHi 0) := by
  have hc := chk0
  rw [Bool.and_eq_true] at hc
  have hT0 : (Arb4.BandGlue_h6000.seg 0).T0 = (Q.ofNat 5000).val := (Q.cv_nat 5000).symm
  have hT1 : (Arb4.BandGlue_h6000.seg 0).T1 = (Q.ofNat 5040).val := (Q.cv_nat 5040).symm
  have hcc : (Arb4.BandGlue_h6000.seg 0).c = (⟨1 / 2, (Q.ofNat 5020).val⟩ : ℂ) := by rw [(Q.cv_nat 5020)]; rfl
  have hR : (Arb4.BandGlue_h6000.seg 0).R = Real.sqrt (Q.frac 6437 16).val := by rw [(Q.cv_frac 6437 16)]; rfl
  refine boxCert_of_parts (Arb4.BandGlue_h6000.seg 0) E0 (Arb4.BandGlue_h6000.seg_edge 0 (by norm_num)).1
    (Arb4.BandGlue_h6000.seg_edge 0 (by norm_num)).2 (valid_of_B _ _ _ _ _ E0 hT0 hT1 hcc hR hc.1)
    (Arb4.BandGlue_h6000.seg_geom 0 (by norm_num)) ?_ ?_ ?_ (k6side_of_B _ G_T5000 G_T5040 E0 hT0 hT1 hc.2) ?_ ?_
