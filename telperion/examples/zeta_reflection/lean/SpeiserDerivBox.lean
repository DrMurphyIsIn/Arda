/-- A box point lies in the disc of its row. -/
theorem dist_le_of_row (s : ℂ) (tc : ℝ) (h1 : 1 / 4 ≤ s.re) (h2 : s.re ≤ 3 / 8)
    (h3 : tc - 1 / 4 ≤ s.im) (h4 : s.im ≤ tc + 1 / 4) :
    ‖s - ArbEcon.Off.sOfG (5 / 16 : ℝ) tc‖ ≤ ((13 / 50 : ℚ) : ℝ) := by
  have hre : (s - ArbEcon.Off.sOfG (5 / 16 : ℝ) tc).re = s.re - 5 / 16 := by simp [ArbEcon.Off.sOfG]
  have him : (s - ArbEcon.Off.sOfG (5 / 16 : ℝ) tc).im = s.im - tc := by simp [ArbEcon.Off.sOfG]
  have hsq : ‖s - ArbEcon.Off.sOfG (5 / 16 : ℝ) tc‖ ^ 2 ≤ ((13 / 50 : ℚ) : ℝ) ^ 2 := by
    rw [Complex.sq_norm, Complex.normSq_apply, hre, him]
    push_cast
    nlinarith [mul_nonneg (sub_nonneg.2 h1) (sub_nonneg.2 h2), mul_nonneg (sub_nonneg.2 h3) (sub_nonneg.2 h4)]
  exact le_of_pow_le_pow_left₀ (by norm_num) (by norm_num) hsq

