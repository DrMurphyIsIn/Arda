/-  H1000Line.lean -- the on-line sign certificate of the height-1000 ladder segment (lane
    h1000-prep, memo ANDURIL_ARB_DISCHARGE_2026-09-23, input H1 `hLine`, brick K4 in EM form).

    THE TWO THEOREMS, PROVED ONCE.  For the Boolean checker `ptCheck p` of `H1000Point` on a point
    record `p : LinePt` (height `t = tn / 2^tq`, EM cut `N`, the two evaluator states, remainder and
    phase hints, and a CLAIMED sign):

        ptCheck_sound : ptCheck p = true →
          (p.pos = true → 0 < gLine t) ∧ (p.pos = false → gLine t < 0),

    and the band assembly `band_sound`: a list of kernel-checked points with alternating signs inside
    `[T0, T1]` (`bandOk`) gives the VERBATIM `hLine` shape of `TuringBand.BandStatement` (`n` strictly
    increasing zeros of `completedRiemannZeta` on the critical line in `[T0, T1]`), through
    `SignChain.alternating_signs_chain`.

    HOW THE SIGN IS CERTIFIED (all kernel arithmetic on `Nat`/`Int`, no hypotheses):
      * `gLine t = M(t) * S(t)`, `S = cos φ · Re ζ(1/2+it) - sin φ · Im ζ(1/2+it)`,
        `M(t) ≥ (3/4) e^{-π|t|/2} > 0`             (`KernelGammaEnvelope.gLine_decomp_explicit`,
                                                      `gammaRMag_bounds`), so sign gLine = sign S;
      * Re ζ, Im ζ : the order-13 Euler-Maclaurin ball (`EMZetaHighEval.zeta_ballK`,
        `EMZetaHighCheck.corr_eq`, `remOdd_sound`), the Dirichlet sum by the ArbEconomics Nat
        evaluator (`ArbEcon.chunk_sound`, `EMZetaHighCheck.valid64`)       [H1000Point.zball_sound];
      * φ = Λ - (t/2) log π : the height-uniform bracket `RSTheta.theta_bracket` evaluated in integers
                                                                        [H1000Phase.phase_sound];
      * cos φ, sin φ : the evaluator's own `ArbEcon.trig` after a `2π m` shift [H1000Point.trig_phase];
      * the product ball `|S · 2^64 · W - sCtr| ≤ sRad` and the sign test   [H1000Point.s_ball].

    Because |ζ(1/2+it)| = |Z(t)| on the line, the φ uncertainty (half-width about 1/(4t)) enters
    only relatively: the certified interval is about Z(t)(1 ± √2/(4t)), plus the absolute EM error.

    The 25 band instances of `BandGlue_h1000.seg` are generated by
    `telperion/examples/zeta_reflection/emit_h1000_line.py` (modules `H1000Line_B00 … B24`,
    assembled in `H1000Line_All`).

    KERNEL FOOTGUN (see `ptCheck_spec`): never make the kernel decide a definitional equality between
    `cond`/`decide` forms on a symbolic point; extract conjuncts by rewriting with lemmas.

    Trust: axioms [propext, Classical.choice, Quot.sound] (see AxiomGuardH1000Line.lean); no
    `sorry`, no `native_decide`, every numeric fact is decided by the kernel (`decide +kernel`).

    conjecture1_proved = False.  Finite interval arithmetic and the intermediate value theorem at
    finitely many heights; nothing here bears on the Riemann Hypothesis.
-/
import H1000Point

open Real Filter Topology
open ArbEcon ArbEcon.OrderK

namespace H1000Line

noncomputable section

/-- `ptCheck`, unfolded (definitional). -/
theorem ptCheck_unfold {p : LinePt} (h : ptCheck p = true) :
    (((((dirOk p && (remP p).1) && decide (0 < (remP p).2.2)) && phaseOk p.tn p.tq p.k)
      && decide (0 ≤ thLo p))
      && (bif p.pos then decide (sRad p < sCtr p) else decide (sCtr p + sRad p < 0))) = true := h

/-- The conjuncts of `ptCheck`.  KERNEL FOOTGUN (found here): never let the kernel decide a
    definitional equality between `cond true A B` / `decide X` forms on a SYMBOLIC point -- its lazy
    delta may unfold `decide` first and evaluate `X` on symbolic data, which unfolds products like
    `p.m * TPLO` in unary and overflows ("deep recursion").  Every step below is a rewrite with a
    lemma (`Bool.and_eq_true`, `cond_true`, `cond_false`) or a syntactic match. -/
theorem ptCheck_spec {p : LinePt} (h : ptCheck p = true) :
    dirOk p = true ∧ (remP p).1 = true ∧ 0 < (remP p).2.2 ∧ phaseOk p.tn p.tq p.k = true ∧
      0 ≤ thLo p ∧ (p.pos = true → sRad p < sCtr p) ∧ (p.pos = false → sCtr p + sRad p < 0) := by
  have h' := ptCheck_unfold h
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true] at h'
  obtain ⟨⟨⟨⟨⟨hdir, hR⟩, hED⟩, hph⟩, hlo0⟩, hs⟩ := h'
  refine ⟨hdir, hR, of_decide_eq_true hED, hph, of_decide_eq_true hlo0, fun hp => ?_, fun hp => ?_⟩
  · have hs' := hs
    rw [hp, cond_true] at hs'
    exact of_decide_eq_true hs'
  · have hs' := hs
    rw [hp, cond_false] at hs'
    exact of_decide_eq_true hs'

/-- **Soundness of the point checker**: the claimed sign of `gLine t` is the true one. -/
theorem ptCheck_sound (p : LinePt) (h : ptCheck p = true) :
    (p.pos = true → 0 < XiLineZeros.gLine (tOf p)) ∧
      (p.pos = false → XiLineZeros.gLine (tOf p) < 0) := by
  obtain ⟨hdir, hR, hED, hph, hlo0, hpos, hneg⟩ := ptCheck_spec h
  obtain ⟨hN, h1, h2⟩ := dirOk_sound p hdir
  obtain ⟨hW, hX, hY⟩ := zball_sound p hN h1 h2 hR hED
  obtain ⟨_, _, _, htn, _⟩ := phaseOk_spec hph
  have htpos : 0 < tOf p := by
    have : (0 : ℝ) < p.tn := by exact_mod_cast htn
    unfold tOf; positivity
  obtain ⟨Λ, hΛ, hMpos, hgl⟩ := gLine_eq_mag_mul p htpos
  obtain ⟨hc, hsn⟩ := trig_phase p hph hlo0 Λ hΛ
  have hSW := s_ball p Λ hc hsn hX hY
  set S := Real.cos (phiOf p Λ) * (riemannZeta (sOf (tOf p))).re
    - Real.sin (phiOf p Λ) * (riemannZeta (sOf (tOf p))).im with hS
  have hKpos : (0 : ℝ) < 2 ^ 64 * (zW p : ℝ) := by positivity
  have eK : S * 2 ^ 64 * (zW p : ℝ) = S * (2 ^ 64 * (zW p : ℝ)) := by ring
  rw [abs_le] at hSW
  constructor
  · intro hp
    have hs' : ((sRad p : ℤ) : ℝ) < ((sCtr p : ℤ) : ℝ) := by exact_mod_cast hpos hp
    have hSpos : 0 * (2 ^ 64 * (zW p : ℝ)) < S * (2 ^ 64 * (zW p : ℝ)) := by
      rw [zero_mul, ← eK]; linarith [hSW.1]
    have : 0 < S := lt_of_mul_lt_mul_right hSpos hKpos.le
    rw [hgl]; exact mul_pos hMpos this
  · intro hp
    have hs' : ((sCtr p : ℤ) : ℝ) + ((sRad p : ℤ) : ℝ) < 0 := by exact_mod_cast hneg hp
    have hSneg : S * (2 ^ 64 * (zW p : ℝ)) < 0 * (2 ^ 64 * (zW p : ℝ)) := by
      rw [zero_mul, ← eK]; linarith [hSW.2]
    have : S < 0 := lt_of_mul_lt_mul_right hSneg hKpos.le
    rw [hgl]; exact mul_neg_of_pos_of_neg hMpos this

/-! ## H. Bands: a list of kernel-checked points gives the `hLine` shape. -/

/-- `t_a < t_b`, cross-multiplied. -/
def tlt (a b : LinePt) : Bool := decide (a.tn * 2 ^ b.tq < b.tn * 2 ^ a.tq)

theorem tlt_sound {a b : LinePt} (h : tlt a b = true) : tOf a < tOf b := by
  have h' : decide (a.tn * 2 ^ b.tq < b.tn * 2 ^ a.tq) = true := h
  have hlt := of_decide_eq_true h'
  have hR : ((a.tn * 2 ^ b.tq : ℕ) : ℝ) < ((b.tn * 2 ^ a.tq : ℕ) : ℝ) := by exact_mod_cast hlt
  push_cast at hR
  unfold tOf
  rw [div_lt_div_iff₀ (by positivity) (by positivity)]
  exact hR

/-- Consecutive points strictly increase and carry opposite claimed signs. -/
def chainOk : List LinePt → Bool
  | a :: b :: rest => (tlt a b && (a.pos != b.pos)) && chainOk (b :: rest)
  | _ => true

theorem chainOk_get : ∀ (ps : List LinePt), chainOk ps = true →
    ∀ (i : ℕ) (h : i + 1 < ps.length),
      tlt (ps[i]'(by omega)) ps[i + 1] = true ∧ (ps[i]'(by omega)).pos ≠ ps[i + 1].pos
  | [], _, i, h => by simp at h
  | [_], _, i, h => by simp at h
  | a :: b :: rest, hc, i, h => by
    have hc' : ((tlt a b && (a.pos != b.pos)) && chainOk (b :: rest)) = true := hc
    rw [Bool.and_eq_true, Bool.and_eq_true] at hc'
    obtain ⟨⟨hab, hpos⟩, hrest⟩ := hc'
    cases i with
    | zero =>
      refine ⟨hab, ?_⟩
      simpa using hpos
    | succ j =>
      have h' : j + 1 < (b :: rest).length := by simp at h ⊢; omega
      have := chainOk_get (b :: rest) hrest j h'
      simpa using this

/-- Every point of the list passes `ptCheck`. -/
def AllOk : List LinePt → Prop
  | [] => True
  | p :: ps => ptCheck p = true ∧ AllOk ps

theorem AllOk.nil : AllOk [] := trivial

theorem AllOk.cons {p : LinePt} {ps : List LinePt} (h : ptCheck p = true) (hs : AllOk ps) :
    AllOk (p :: ps) := ⟨h, hs⟩

theorem AllOk_get : ∀ (ps : List LinePt), AllOk ps → ∀ (i : ℕ) (h : i < ps.length),
    ptCheck ps[i] = true
  | [], _, i, h => by simp at h
  | p :: ps, hall, i, h => by
    obtain ⟨hp, hps⟩ := hall
    cases i with
    | zero => simpa using hp
    | succ j => simpa using AllOk_get ps hps j (by simp at h; omega)

/-- The first point is at or above `T0 = T0n / T0d`. -/
def firstGe (T0n T0d : ℕ) : List LinePt → Bool
  | a :: _ => decide (T0n * 2 ^ a.tq ≤ a.tn * T0d)
  | [] => false

/-- The last point is at or below `T1 = T1n / T1d`. -/
def lastLe (T1n T1d : ℕ) : List LinePt → Bool
  | [a] => decide (a.tn * T1d ≤ T1n * 2 ^ a.tq)
  | _ :: b :: rest => lastLe T1n T1d (b :: rest)
  | [] => false

theorem firstGe_sound (T0n T0d : ℕ) (hd : 0 < T0d) : ∀ (ps : List LinePt) (h : 0 < ps.length),
    firstGe T0n T0d ps = true → (T0n : ℝ) / T0d ≤ tOf (ps[0]'h)
  | [], h, _ => by simp at h
  | a :: _, _, hf => by
    have hf' : decide (T0n * 2 ^ a.tq ≤ a.tn * T0d) = true := hf
    have hle := of_decide_eq_true hf'
    have hR : ((T0n * 2 ^ a.tq : ℕ) : ℝ) ≤ ((a.tn * T0d : ℕ) : ℝ) := by exact_mod_cast hle
    push_cast at hR
    show (T0n : ℝ) / T0d ≤ (a.tn : ℝ) / 2 ^ a.tq
    have hdR : (0 : ℝ) < T0d := by exact_mod_cast hd
    rw [div_le_div_iff₀ hdR (by positivity)]
    linarith

theorem lastLe_sound (T1n T1d : ℕ) (hd : 0 < T1d) : ∀ (ps : List LinePt), lastLe T1n T1d ps = true →
    ∀ (i : ℕ) (hi : i + 1 = ps.length), tOf (ps[i]'(by omega)) ≤ (T1n : ℝ) / T1d
  | [], _, i, hi => by simp at hi
  | [a], hl, i, hi => by
    have hi0 : i = 0 := by simp at hi; omega
    subst hi0
    have hl' : decide (a.tn * T1d ≤ T1n * 2 ^ a.tq) = true := hl
    have hle := of_decide_eq_true hl'
    have hR : ((a.tn * T1d : ℕ) : ℝ) ≤ ((T1n * 2 ^ a.tq : ℕ) : ℝ) := by exact_mod_cast hle
    push_cast at hR
    show (a.tn : ℝ) / 2 ^ a.tq ≤ (T1n : ℝ) / T1d
    have hdR : (0 : ℝ) < T1d := by exact_mod_cast hd
    rw [div_le_div_iff₀ (by positivity) hdR]
    linarith
  | a :: b :: rest, hl, i, hi => by
    have hl' : lastLe T1n T1d (b :: rest) = true := hl
    cases i with
    | zero => simp at hi
    | succ j =>
      have := lastLe_sound T1n T1d hd (b :: rest) hl' j (by simp at hi ⊢; omega)
      simpa using this

/-- **The band checker**: `n + 1` points, strictly increasing, alternating claimed signs, the first
    at or above `T0 = T0n/T0d`, the last at or below `T1 = T1n/T1d`. -/
def bandOk (T0n T0d T1n T1d n : ℕ) (ps : List LinePt) : Bool :=
  decide (ps.length = n + 1) && chainOk ps && decide (0 < T0d) && decide (0 < T1d) &&
    firstGe T0n T0d ps && lastLe T1n T1d ps

/-- **A band of kernel-checked points gives the band's `hLine`**: `n` strictly increasing zeros of
    `completedRiemannZeta` on the critical line in `[T0, T1]` (the verbatim `hLine` binder of
    `TuringBand.BandStatement`, via `SignChain.alternating_signs_chain`). -/
theorem band_sound (T0 T1 : ℝ) (T0n T0d T1n T1d n : ℕ) (hT0 : T0 = (T0n : ℝ) / T0d)
    (hT1 : T1 = (T1n : ℝ) / T1d) (ps : List LinePt) (hall : AllOk ps)
    (hb : bandOk T0n T0d T1n T1d n ps = true) :
    ∃ xs : List ℝ, xs.length = n ∧ xs.IsChain (· < ·) ∧ (∀ t ∈ xs, T0 ≤ t ∧ t ≤ T1) ∧
      (∀ t ∈ xs, completedRiemannZeta (1 / 2 + (t : ℂ) * Complex.I) = 0) := by
  have hb' : (((((decide (ps.length = n + 1) && chainOk ps) && decide (0 < T0d)) && decide (0 < T1d))
      && firstGe T0n T0d ps) && lastLe T1n T1d ps) = true := hb
  rw [Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true, Bool.and_eq_true] at hb'
  obtain ⟨⟨⟨⟨⟨hlen, hch⟩, hd0⟩, hd1⟩, hfirst⟩, hlast⟩ := hb'
  have hlen' : decide (ps.length = n + 1) = true := hlen
  have hd0' : decide (0 < T0d) = true := hd0
  have hd1' : decide (0 < T1d) = true := hd1
  have hL := of_decide_eq_true hlen'
  have hD0 := of_decide_eq_true hd0'
  have hD1 := of_decide_eq_true hd1'
  let pt : Fin (n + 1) → ℝ := fun i => tOf (ps[i.1]'(by rw [hL]; exact i.2))
  apply ZetaReflection.alternating_signs_chain T0 T1 n pt
  · rw [Fin.strictMono_iff_lt_succ]
    intro i
    have h := chainOk_get ps hch i.1 (by rw [hL]; omega)
    exact tlt_sound h.1
  · rw [hT0]
    exact firstGe_sound T0n T0d hD0 ps (by rw [hL]; omega) hfirst
  · rw [hT1]
    exact lastLe_sound T1n T1d hD1 ps hlast n hL.symm
  · intro i
    have hc := chainOk_get ps hch i.1 (by rw [hL]; omega)
    have hA := ptCheck_sound _ (AllOk_get ps hall i.1 (by rw [hL]; omega))
    have hB := ptCheck_sound _ (AllOk_get ps hall (i.1 + 1) (by rw [hL]; omega))
    show XiLineZeros.gLine (tOf (ps[i.1]'(by rw [hL]; omega)))
        * XiLineZeros.gLine (tOf (ps[i.1 + 1]'(by rw [hL]; omega))) < 0
    rcases Bool.eq_false_or_eq_true (ps[i.1]'(by rw [hL]; omega)).pos with ha | ha
    · have hb2 : (ps[i.1 + 1]'(by rw [hL]; omega)).pos = false := by
        have := hc.2; rw [ha] at this; cases h2 : (ps[i.1 + 1]'(by rw [hL]; omega)).pos
        · rfl
        · rw [h2] at this; exact absurd rfl this
      exact mul_neg_of_pos_of_neg (hA.1 ha) (hB.2 hb2)
    · have hb2 : (ps[i.1 + 1]'(by rw [hL]; omega)).pos = true := by
        have := hc.2; rw [ha] at this; cases h2 : (ps[i.1 + 1]'(by rw [hL]; omega)).pos
        · rw [h2] at this; exact absurd rfl this
        · rfl
      exact mul_neg_of_neg_of_pos (hA.2 ha) (hB.1 hb2)

end

end H1000Line
