/-  Probes/RSDesign_bench.lean -- TIMING PROBE ONLY (no soundness claim): the kernel cost of an
    RS-style main-sum loop, 211 terms (N = floor(sqrt(280000/2pi))), 64-bit fixed point, Nat-only
    GMP primitives: per term one reduction mod 2pi, a 20-step Horner, two scalings.  The value checked
    is whatever the loop returns (precomputed by an untrusted script); nothing is claimed about cos.
    conjecture1_proved = False. -/
namespace RSDesignBench
def P : Nat := 18446744073709551616
def TWOPI : Nat := 115904311329233965478
def hstep (r2 : Nat) (k : Nat) (h : Nat) : Nat :=
  let v := Nat.div (Nat.mul r2 h) (Nat.mul P (Nat.mul (Nat.mul 2 k) (Nat.sub (Nat.mul 2 k) 1)))
  Nat.sub P v
def horner (r2 : Nat) : Nat :=
  (hstep r2 1 (hstep r2 2 (hstep r2 3 (hstep r2 4 (hstep r2 5 (hstep r2 6 (hstep r2 7 (hstep r2 8 (hstep r2 9 (hstep r2 10 (hstep r2 11 (hstep r2 12 (hstep r2 13 (hstep r2 14 (hstep r2 15 (hstep r2 16 (hstep r2 17 (hstep r2 18 (hstep r2 19 (hstep r2 20 P))))))))))))))))))))
def term (a l : Nat) : Nat :=
  let r := Nat.mod (Nat.mul 280000 l) TWOPI
  Nat.div (Nat.mul a (horner (Nat.div (Nat.mul r r) P))) P
