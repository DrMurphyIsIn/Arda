def lnf (m : Nat) : Nat × Nat × Nat :=
  let p1 := m
  let p2 := Nat.mul p1 m
  let p3 := Nat.mul p2 m
  let p4 := Nat.mul p3 m
  let p5 := Nat.mul p4 m
  (Nat.add (Nat.add (Nat.add (Nat.add (0) (Nat.div 18446744073709551616 (Nat.mul p1 1))) (Nat.div 18446744073709551616 (Nat.mul p2 2))) (Nat.div 18446744073709551616 (Nat.mul p3 3))) (Nat.div 18446744073709551616 (Nat.mul p4 4)), 4, p5)
def cfg : ArbEcon.Cfg := ⟨64, 18446744073709551616, 36893488147419103232, 340282366920938463463374607431768211456, 1000, 0, 28976077832308491369, 14488038916154245684, 2, 14987979559889010688, 1, [5644703686555122794496, 4427218577690292387840, 3357307421415138394112, 2434970217729660813312, 1660206966633859645440, 1033017668127734890496, 553402322211286548480, 221360928884514619392, 36893488147419103232], [6308786473208666652672, 5017514388048998039552, 3873816255479005839360, 2877692075498690052096, 2029141848108050677760, 1328165573307087716352, 774763251095801167872, 368934881474191032320, 110680464442257309696], hc, hs, 65, 8192, 4, lnf, 12, 16384⟩
def e_log (cnt : Nat) : Nat → Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat) (fun _ acc => acc)
    (fun _ ih m acc => ih (Nat.succ m) (Nat.add acc (ArbEcon.logInc cfg m).1)) cnt
def e_sqrt (cnt : Nat) : Nat → Nat → Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat → Nat) (fun _ _ acc => acc)
    (fun _ ih m g acc => let g2 := ArbEcon.isqrt cfg m (Nat.div cfg.oneSq m) g; ih (Nat.succ m) g2 (Nat.add acc g2)) cnt
def e_trig (cnt : Nat) : Nat → Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat) (fun _ acc => acc)
    (fun _ ih m acc =>
      let th := Nat.div (Nat.mul (Nat.mul cfg.one m) 1000) 7
      let tr := ArbEcon.trig cfg th (Nat.add th 5)
      ih (Nat.succ m) (Nat.add acc (Nat.add (Nat.add tr.cm tr.sm) tr.cr))) cnt
def e_horner (cnt : Nat) : Nat → Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat) (fun _ acc => acc)
    (fun _ ih m acc => ih (Nat.succ m) (Nat.add acc (cfg.hc (Nat.div (Nat.mul m cfg.one) 24000)))) cnt
def e_empty (cnt : Nat) : Nat → Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat) (fun _ acc => acc)
    (fun _ ih m acc => ih (Nat.succ m) (Nat.add acc m)) cnt

