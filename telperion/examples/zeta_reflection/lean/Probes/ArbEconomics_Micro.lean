def c_listRec (ds : List Nat) (cnt : Nat) : Nat → Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat) (fun _ acc => acc)
    (fun _ ih m acc => ih (Nat.succ m) (Nat.add acc (ArbEcon.horner 18446744073709551616 (Nat.div (Nat.mul m 18446744073709551616) 12000) ds 18446744073709551616))) cnt
def c_unrolled (cnt : Nat) : Nat → Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat) (fun _ acc => acc)
    (fun _ ih m acc => ih (Nat.succ m) (Nat.add acc (hornU (Nat.div (Nat.mul m 18446744073709551616) 12000)))) cnt
def dcosList : List Nat := [5644703686555122794496, 4427218577690292387840, 3357307421415138394112, 2434970217729660813312, 1660206966633859645440, 1033017668127734890496, 553402322211286548480, 221360928884514619392, 36893488147419103232]

def xnor (a b : Bool) : Bool := Bool.rec (Bool.rec true false b) (Bool.rec false true b) a
def d_beq (cnt : Nat) : Nat → Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat) (fun _ acc => acc)
    (fun _ ih k acc => ih (Nat.succ k) (Nat.add acc (Bool.rec 0 1 ((Nat.beq (Nat.mod k 2) 0) == (Nat.beq (Nat.mod k 3) 0))))) cnt
def d_xnor (cnt : Nat) : Nat → Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat) (fun _ acc => acc)
    (fun _ ih k acc => ih (Nat.succ k) (Nat.add acc (Bool.rec 0 1 (xnor (Nat.beq (Nat.mod k 2) 0) (Nat.beq (Nat.mod k 3) 0))))) cnt

