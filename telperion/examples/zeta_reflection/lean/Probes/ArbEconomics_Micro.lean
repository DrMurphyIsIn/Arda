/-  Probes/ArbEconomics_Micro.lean -- kernel cost microbenchmarks (GENERATED by gen_micro.py).

    Each `theorem` is a kernel `decide +kernel` check; read the kernel time of each with
      lean -Dprofiler=true -Dprofiler.threshold=1 Probes/ArbEconomics_Micro.lean
    (the lean_lib-free command line is in the ArbEconomics report).  Measured on this host
    (M3 Ultra, v4.32.0), 2026-09-23:

      A. 1e5-iteration loops, 5 mul + 5 shift + 6 add per iteration on ~128-bit numbers
         a_natDirect   (Nat.mul/Nat.add/Nat.shiftRight called directly)   ~2.5 s  (~1.5 us/op)
         a_natNotation (the same with * + >>> on Nat)                     ~9.8 s  (4x)
         a_intDirect   (Int.mul/Int.add/Int.shiftRight called directly)   ~53 s   (21x)
         a_intNotation (the same with notation on Int)                    ~60 s   (24x)
      B. loop overhead, 1e5 iterations of one mul + one add
         b_brecOn (structural recursion by pattern matching)              ~1.5 s
         b_natRec (raw Nat.rec)                                           ~0.33 s (4.7x)
      C. Horner, 2000 evaluations of a 9-step cos Horner
         c_listRec  (List.rec over the divisor list)                      ~130-180 ms
         c_unrolled (per-config unrolled function)                        ~48 ms  (2.7-3.8x)
      D. Bool equality, 20000 evaluations (loop includes 2 mod + 2 beq)
         d_beq  (`a == b` via the BEq/DecidableEq instance)               ~420-475 ms
         d_xnor (raw Bool.rec)                                            ~166 ms (== costs ~13 us more)
      E. evaluator components (2000 calls each, m >= 10000; per call)
         e_log 17 us, e_sqrt 26 us, e_trig 107 us (e_horner 25 us per 9-step Horner), loop 2.5 us

    Also measured (not in this file): plain `decide` = elaborator evaluation + kernel re-check,
    2.4x `decide +kernel` on a 20-term chunk, and it hits `maxRecDepth` on 500-term chunks.

    conjecture1_proved = False.
-/
import Probes.ArbEconomics_Eval

namespace ArbEcon.Micro

noncomputable section

def a_natDirect (n : Nat) : Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat) (fun acc => acc)
    (fun k ih acc =>
      let x := Nat.add k 340282366920938463463374607431768211297
      let a1 := Nat.shiftRight (Nat.mul x x) 128
      let a2 := Nat.shiftRight (Nat.mul a1 x) 128
      let a3 := Nat.shiftRight (Nat.mul a2 x) 128
      let a4 := Nat.shiftRight (Nat.mul a3 x) 128
      let a5 := Nat.shiftRight (Nat.mul a4 x) 128
      ih (Nat.add acc (Nat.add a1 (Nat.add a2 (Nat.add a3 (Nat.add a4 a5)))))) n
def a_natNotation (n : Nat) : Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat) (fun acc => acc)
    (fun k ih acc =>
      let x := k + 340282366920938463463374607431768211297
      let a1 := (x * x) >>> 128
      let a2 := (a1 * x) >>> 128
      let a3 := (a2 * x) >>> 128
      let a4 := (a3 * x) >>> 128
      let a5 := (a4 * x) >>> 128
      ih (acc + (a1 + (a2 + (a3 + (a4 + a5)))))) n
def a_intDirect (n : Nat) : Int → Int :=
  Nat.rec (motive := fun _ => Int → Int) (fun acc => acc)
    (fun k ih acc =>
      let x : Int := Int.sub (Int.ofNat k) 340282366920938463463374607431768211297
      let a1 := Int.shiftRight (Int.mul x x) 128
      let a2 := Int.shiftRight (Int.mul a1 x) 128
      let a3 := Int.shiftRight (Int.mul a2 x) 128
      let a4 := Int.shiftRight (Int.mul a3 x) 128
      let a5 := Int.shiftRight (Int.mul a4 x) 128
      ih (Int.add acc (Int.add a1 (Int.add a2 (Int.add a3 (Int.add a4 a5)))))) n
def a_intNotation (n : Nat) : Int → Int :=
  Nat.rec (motive := fun _ => Int → Int) (fun acc => acc)
    (fun k ih acc =>
      let x : Int := (k : Int) - 340282366920938463463374607431768211297
      let a1 := (x * x) >>> 128
      let a2 := (a1 * x) >>> 128
      let a3 := (a2 * x) >>> 128
      let a4 := (a3 * x) >>> 128
      let a5 := (a4 * x) >>> 128
      ih (acc + (a1 + (a2 + (a3 + (a4 + a5)))))) n

def b_brecOn : Nat → Nat → Nat
  | 0, acc => acc
  | n+1, acc => b_brecOn n (Nat.add acc (Nat.mul n n))
def b_natRec (n : Nat) : Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat) (fun acc => acc) (fun k ih acc => ih (Nat.add acc (Nat.mul k k))) n

