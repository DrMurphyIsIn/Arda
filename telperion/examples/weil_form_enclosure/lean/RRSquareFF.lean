import RRSquare

/-!
# Function-field instances of the RR-square axioms (generated by `ff/gen_lean.py`)

Frobenius-graph Gram on span{f₁, f₂, Γ₀, …, Γ₄}: Γ_m·Γ_n = q^min(m,n) N_|m-n| (N₀ := 2 - 2g), Γ_n·f₁ = 1,
Γ_n·f₂ = qⁿ, f₁² = f₂² = 0, f₁·f₂ = 1 (`~/arda-research/gate6/g6_ff_dictionary.md`). Degree class h = f₁ + f₂.

* `G2F5`: the genus-2 curve y² = x⁵ + x³ + 3x + 2 over F₅, P(T) = 1 - 3T + 7T² - 15T³ + 25T⁴. The Hodge index on the
  graph span holds by an exact sum-of-squares certificate, so (via `collapse`) the bounded axioms are satisfiable.
* `FK3`: an on-circle fake over F₂ with N₁ = -1 < 0. It also passes the Hodge index, while Γ₀·Γ₁ = N₁ < 0: two distinct
  "graphs" with negative intersection, impossible for effective curves. Geometric effectivity of the graphs is
  therefore invisible to the RR axioms as stated; it would have to be added as a further axiom.
* `FK2`: an off-circle fake over F₃. The Hodge index fails, by an explicit vector.

conjecture1_proved = False.
-/

namespace RRSquare.FF

open Matrix

/-- Bilinear form of a Gram matrix, `B x y = Σᵢ Σⱼ Mᵢⱼ xᵢ yⱼ`. -/
noncomputable def Bm (M : Matrix (Fin 7) (Fin 7) ℝ) : LinearMap.BilinForm ℝ (Fin 7 → ℝ) :=
  LinearMap.mk₂ ℝ (fun x y => ∑ i, ∑ j, M i j * x i * y j)
    (by intro a b c; simp only [Pi.add_apply]; rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_; rw [← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl fun j _ => by ring)
    (by intro c a b; simp only [Pi.smul_apply, smul_eq_mul]; rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_; rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun j _ => by ring)
    (by intro a b c; simp only [Pi.add_apply]; rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_; rw [← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl fun j _ => by ring)
    (by intro c a b; simp only [Pi.smul_apply, smul_eq_mul]; rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_; rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun j _ => by ring)

lemma Bm_apply (M : Matrix (Fin 7) (Fin 7) ℝ) (x y : Fin 7 → ℝ) :
    Bm M x y = ∑ i, ∑ j, M i j * x i * y j := rfl

/-- The degree class h = f₁ + f₂. -/
def h : Fin 7 → ℝ := ![1, 1, 0, 0, 0, 0, 0]

/-- Graph-span Gram of y² = x⁵ + x³ + 3x + 2 over F₅ (N₁..N₄ = 3, 31, 117, 619). -/
def G2F5 : Matrix (Fin 7) (Fin 7) ℝ :=
  !![0, 1, 1, 1, 1, 1, 1;
    1, 0, 1, 5, 25, 125, 625;
    1, 1, -2, 3, 31, 117, 619;
    1, 5, 3, -10, 15, 155, 585;
    1, 25, 31, 15, -50, 75, 775;
    1, 125, 117, 155, 75, -250, 375;
    1, 625, 619, 585, 775, 375, -1250]

lemma G2F5_symm : (Bm G2F5).IsSymm := by
  refine ⟨fun x y => ?_⟩
  simp [Bm_apply, G2F5, Fin.sum_univ_succ]
  ring

lemma G2F5_hh : 0 < Bm G2F5 h h := by
  simp [Bm_apply, G2F5, h, Fin.sum_univ_succ]

/-- Exact certificate: h² B(v,v) - B(v,h)² = -(sum of squares). -/
lemma G2F5_cert (v : Fin 7 → ℝ) :
    2 * Bm G2F5 v v - (Bm G2F5 v h) ^ 2 =
      -((1 : ℝ) * ((1 : ℝ) * v 0 + (-1 : ℝ) * v 1 + (4 : ℝ) * v 3 + (24 : ℝ) * v 4 + (124 : ℝ) * v 5 + (624 : ℝ) * v 6) ^ 2 + (8 : ℝ) * ((1 : ℝ) * v 2 + ((3 : ℝ) / 4) * v 3 + ((-5 : ℝ) / 4) * v 4 + ((9 : ℝ) / 4) * v 5 + ((7 : ℝ) / 4) * v 6) ^ 2 + ((71 : ℝ) / 2) * ((1 : ℝ) * v 3 + ((75 : ℝ) / 71) * v 4 + ((-127 : ℝ) / 71) * v 5 + ((159 : ℝ) / 71) * v 6) ^ 2 + ((10500 : ℝ) / 71) * ((1 : ℝ) * v 4 + ((81 : ℝ) / 50) * v 5 + ((-107 : ℝ) / 50) * v 6) ^ 2 + ((2289 : ℝ) / 5) * ((1 : ℝ) * v 5 + (3 : ℝ) * v 6) ^ 2) := by
  simp [Bm_apply, G2F5, h, Fin.sum_univ_succ]
  ring

theorem G2F5_hodge (v : Fin 7 → ℝ) (hv : Bm G2F5 v h = 0) : Bm G2F5 v v ≤ 0 := by
  have c := G2F5_cert v
  rw [hv] at c
  have : 0 ≤ (1 : ℝ) * ((1 : ℝ) * v 0 + (-1 : ℝ) * v 1 + (4 : ℝ) * v 3 + (24 : ℝ) * v 4 + (124 : ℝ) * v 5 + (624 : ℝ) * v 6) ^ 2 + (8 : ℝ) * ((1 : ℝ) * v 2 + ((3 : ℝ) / 4) * v 3 + ((-5 : ℝ) / 4) * v 4 + ((9 : ℝ) / 4) * v 5 + ((7 : ℝ) / 4) * v 6) ^ 2 + ((71 : ℝ) / 2) * ((1 : ℝ) * v 3 + ((75 : ℝ) / 71) * v 4 + ((-127 : ℝ) / 71) * v 5 + ((159 : ℝ) / 71) * v 6) ^ 2 + ((10500 : ℝ) / 71) * ((1 : ℝ) * v 4 + ((81 : ℝ) / 50) * v 5 + ((-107 : ℝ) / 50) * v 6) ^ 2 + ((2289 : ℝ) / 5) * ((1 : ℝ) * v 5 + (3 : ℝ) * v 6) ^ 2 := by positivity
  linarith

/-- The bounded RR-square axioms are satisfiable on this graph span (`Div = V`). -/
theorem G2F5_model : Nonempty (RRAxiomsBounded (Bm G2F5) h (LinearMap.id : (Fin 7 → ℝ) →ₗ[ℝ] (Fin 7 → ℝ))) :=
  (collapse G2F5_symm G2F5_hh).2 G2F5_hodge

/-- On-circle fake over F₂, P = 1 - 4T + 8T² - 8T³ + 4T⁴, N₁ = -1. -/
def FK3 : Matrix (Fin 7) (Fin 7) ℝ :=
  !![0, 1, 1, 1, 1, 1, 1;
    1, 0, 1, 2, 4, 8, 16;
    1, 1, -2, -1, 5, 17, 33;
    1, 2, -1, -4, -2, 10, 34;
    1, 4, 5, -2, -8, -4, 20;
    1, 8, 17, 10, -4, -16, -8;
    1, 16, 33, 34, 20, -8, -32]

lemma FK3_symm : (Bm FK3).IsSymm := by
  refine ⟨fun x y => ?_⟩
  simp [Bm_apply, FK3, Fin.sum_univ_succ]
  ring

lemma FK3_hh : 0 < Bm FK3 h h := by
  simp [Bm_apply, FK3, h, Fin.sum_univ_succ]

/-- Exact certificate: h² B(v,v) - B(v,h)² = -(sum of squares). -/
lemma FK3_cert (v : Fin 7 → ℝ) :
    2 * Bm FK3 v v - (Bm FK3 v h) ^ 2 =
      -((1 : ℝ) * ((1 : ℝ) * v 0 + (-1 : ℝ) * v 1 + (1 : ℝ) * v 3 + (3 : ℝ) * v 4 + (7 : ℝ) * v 5 + (15 : ℝ) * v 6) ^ 2 + (8 : ℝ) * ((1 : ℝ) * v 2 + (1 : ℝ) * v 3 + (-2 : ℝ) * v 5 + (-4 : ℝ) * v 6) ^ 2 + (8 : ℝ) * ((1 : ℝ) * v 3 + (2 : ℝ) * v 4 + (2 : ℝ) * v 5) ^ 2) := by
  simp [Bm_apply, FK3, h, Fin.sum_univ_succ]
  ring

theorem FK3_hodge (v : Fin 7 → ℝ) (hv : Bm FK3 v h = 0) : Bm FK3 v v ≤ 0 := by
  have c := FK3_cert v
  rw [hv] at c
  have : 0 ≤ (1 : ℝ) * ((1 : ℝ) * v 0 + (-1 : ℝ) * v 1 + (1 : ℝ) * v 3 + (3 : ℝ) * v 4 + (7 : ℝ) * v 5 + (15 : ℝ) * v 6) ^ 2 + (8 : ℝ) * ((1 : ℝ) * v 2 + (1 : ℝ) * v 3 + (-2 : ℝ) * v 5 + (-4 : ℝ) * v 6) ^ 2 + (8 : ℝ) * ((1 : ℝ) * v 3 + (2 : ℝ) * v 4 + (2 : ℝ) * v 5) ^ 2 := by positivity
  linarith

/-- The bounded RR-square axioms are satisfiable on this graph span (`Div = V`). -/
theorem FK3_model : Nonempty (RRAxiomsBounded (Bm FK3) h (LinearMap.id : (Fin 7 → ℝ) →ₗ[ℝ] (Fin 7 → ℝ))) :=
  (collapse FK3_symm FK3_hh).2 FK3_hodge

/-- In FK3 the "graphs" Γ₀ and Γ₁ meet negatively (entry (2,3) is N₁ = -1). -/
theorem FK3_graphs_meet_negatively : FK3 2 3 < 0 := by simp [FK3]

/-- Off-circle fake over F₃, P = 1 - 7T + 19T² - 21T³ + 9T⁴ (N₁..N₄ = -3, -1, 21, 131). -/
def FK2 : Matrix (Fin 7) (Fin 7) ℝ :=
  !![0, 1, 1, 1, 1, 1, 1;
    1, 0, 1, 3, 9, 27, 81;
    1, 1, -2, -3, -1, 21, 131;
    1, 3, -3, -6, -9, -3, 63;
    1, 9, -1, -9, -18, -27, -9;
    1, 27, 21, -3, -27, -54, -81;
    1, 81, 131, 63, -9, -81, -162]

/-- The Hodge index fails for FK2: an explicit vector orthogonal to h with positive square. -/
theorem FK2_hodge_fails : ∃ v : Fin 7 → ℝ, Bm FK2 v h = 0 ∧ 0 < Bm FK2 v v :=
  ⟨![8, 6, -6, -4, 1, 6, -2], by
    simp [Bm_apply, FK2, h, Fin.sum_univ_succ]; norm_num,
   by simp [Bm_apply, FK2, Fin.sum_univ_succ]; norm_num⟩

/-- So FK2 has no model of the bounded axioms on its graph span. -/
theorem FK2_no_model : IsEmpty (RRAxiomsBounded (Bm FK2) h (LinearMap.id : (Fin 7 → ℝ) →ₗ[ℝ] (Fin 7 → ℝ))) := by
  constructor
  intro A
  obtain ⟨v, hv, hpos⟩ := FK2_hodge_fails
  have := hodge_index A v hv
  linarith

end RRSquare.FF
