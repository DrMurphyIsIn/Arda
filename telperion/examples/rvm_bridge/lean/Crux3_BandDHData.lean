/-- The defining identity of the coefficients of `-D'/D` (`-D' = D (-D'/D)`), on `n <= 56`. -/
theorem cD_conv : ∀ n : ℕ, 1 ≤ n → n ≤ 56 →
    aD n * Real.log n = ∑ d ∈ n.divisors, cD d * aD (n / d) := by
  intro n h1 h2
  interval_cases n
  · exact cD_conv_1
  · exact cD_conv_2
