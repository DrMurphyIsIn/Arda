/-- The coefficients `c_D(n)` of `-D'/D`, `n <= 56` (zero beyond: only `n <= 56` enter the window). -/
def cD (n : ℕ) : ℝ := cDexpr (dtab n)

lemma cD_conv_1 : aD 1 * Real.log (1 : ℕ) = ∑ d ∈ Nat.divisors 1, cD d * aD (1 / d) := by
  have hdiv : Nat.divisors 1 = {1} := by decide
  rw [hdiv]
  simp only [Finset.sum_singleton]
  simp only [cD, cDexpr, dtab, polyEval, aD, List.map, List.sum_cons, List.sum_nil]
  norm_num
  try push_cast
  try ring

