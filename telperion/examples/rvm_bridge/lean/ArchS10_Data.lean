/-- The weighted Cauchy-Schwarz + Bessel bound for `Σ_{n∈S} (T φ_n ω)²`. -/
def Abnd (Ψ : ℕ → ℚ) (ζ : ℚ) (c : ℕ → ℚ) : ℚ :=
  (∑ i ∈ range (Jd + 1), c i) *
    ((∑ m ∈ range Jd, (if m ≤ NCw then thq m ^ 2 * Ψ m ^ 2 * rhoQ ^ 2 / ((|thq m| - d0Q) ^ 2 * c m)
        else thq m ^ 2 * Ψ m ^ 2 * (1 + gamQ) / c m)) + ζ ^ 2 / c Jd)
def AQ : ℚ := (579 / 100000000000 : ℚ)
def AdQ : ℚ := (247 / 250000000 : ℚ)
def A1Q : ℚ := (117 / 1000000000000000000000000 : ℚ)
def tauQ : ℚ := (161 / 25000000 : ℚ)
def tauE : ℚ := (59 / 500000000000000000000000 : ℚ)
def tailOK : Bool :=
  ((List.range (Jd + 1)).all fun i => decide (0 < cA i) && decide (0 < cAd i) && decide (0 < cA1 i)) &&
  ((List.range (NCw + 1)).all fun m => decide (d0Q < |thq m|)) &&
  decide (Abnd PsiQ zeta2Q cA ≤ AQ) && decide (Abnd PsidQ zetad2Q cAd ≤ AdQ) &&
  decide (Abnd Psi1Q zeta1Q cA1 ≤ A1Q) && decide (d0Q < 1) &&
  decide ((4 * AdQ + (AdQ + AQ) / 2 + 2 * (AQ + AdQ)) / (1 - d0Q ^ 2) ≤ tauQ) &&
  decide (A1Q / (1 - d0Q ^ 2) ≤ tauE)

/-! The polynomial. -/
def L0 : ℕ := 25
def NP : ℕ := 67
def bQ : ℚ := (108304247 / 156250000 : ℚ)
def bet (l : ℕ) : ℚ := (4 * l + 1) / 2
/-- Coefficients of `P(t) = Σ_{i<NP} pco i t^i ≈ Qε(t)` on `[0, log 2]`. -/
def pco (i : ℕ) : ℚ := ∑ l ∈ range L0, dq l * (bet l ^ i - (-bet l) ^ i) / (i.factorial : ℚ)
def deltaP : ℚ := (187 / 10000000000 : ℚ)
def Pmax : ℚ := (39900 / 1 : ℚ)
def polyOK : Bool :=
  ((List.range L0).all fun l => decide (bet l * bQ ≤ ((NP : ℚ) + 1) / 2)) &&
  decide ((∑ l ∈ range L0, |dq l| * 4 * (bet l * bQ) ^ NP / (NP.factorial : ℚ))
    + (∑ l ∈ range (Jd - L0), |dq (L0 + l)| * (2 ^ (2 * (L0 + l) + 1) + 1)) ≤ deltaP) &&
  decide ((∑ i ∈ range NP, |pco i| * bQ ^ i) ≤ Pmax)

/-! Totals. -/
def dQtot : ℚ := (129 / 20000000 : ℚ)
def deltaE : ℚ := (119 / 1000000000000000000000000 : ℚ)
def deltaChi : ℚ := (141 / 1000000000 : ℚ)
def totalOK : Bool :=
  decide ((∑ n ∈ range NH, errHq n) + (∑ l ∈ range Jd, (NH : ℚ) * eDQ * (2 ^ (2 * l + 1) + 1)) + tauQ ≤ dQtot) &&
  decide ((∑ n ∈ range NH, errEq n) + eEQ + tauE ≤ deltaE) && decide (0 < EQ - deltaE) &&
  decide ((dQtot + deltaP) / (2 * (EQ - deltaE)) + Pmax * deltaE / (2 * (EQ - deltaE) * EQ) ≤ deltaChi)

/-- The certified polynomial for χ: `χ(v) ≈ Σ_{i<NP} chiCo i |v|^i` on `|v| ≤ log 2`. -/
def chiCo (i : ℕ) : ℚ := pco i / (2 * EQ)

