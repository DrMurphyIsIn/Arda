def PhiL : List (List ℚ) := [[(1 : ℚ)],
    [(-1 : ℚ), (2 : ℚ)],
    [(1 : ℚ), (-6 : ℚ), (6 : ℚ)],
    [(-1 : ℚ), (12 : ℚ), (-30 : ℚ), (20 : ℚ)],
