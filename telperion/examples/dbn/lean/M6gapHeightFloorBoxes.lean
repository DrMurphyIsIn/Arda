theorem slab_0 (σ t : ℝ) (h1 : (1/2 : ℝ) ≤ σ) (h2 : σ ≤ (3/4 : ℝ)) (h3 : 0 ≤ t) (h4 : t ≤ 55 / 16) :
    1 / 4 < ‖G2 ((σ : ℂ) + (t : ℂ) * I)‖ := by
  rcases le_total t (55/256 : ℝ) with ha0 | hb0
  · exact box_0_0 σ t h1 h2 h3 ha0
  rcases le_total t (55/128 : ℝ) with ha1 | hb1
  · exact box_0_1 σ t h1 h2 hb0 ha1
  rcases le_total t (165/256 : ℝ) with ha2 | hb2
  · exact box_0_2 σ t h1 h2 hb1 ha2
  rcases le_total t (55/64 : ℝ) with ha3 | hb3
  · exact box_0_3 σ t h1 h2 hb2 ha3
